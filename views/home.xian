{{> head }}
<body class="flex flex-col min-h-screen" style="background:#0a0f1e">

<!-- Navbar -->
<header class="sticky top-0 z-50 backdrop-blur-lg" style="background:rgba(10,15,30,0.92);border-bottom:1px solid rgba(255,255,255,0.07);box-shadow:0 4px 24px rgba(0,0,0,0.3)">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 flex-shrink-0">
      <div class="w-9 h-9 rounded-full overflow-hidden flex-shrink-0 shadow-lg" style="border:2px solid rgba(255,255,255,0.2)">
        <img src="/scoresync-logo.png" alt="ScoreSync" class="w-full h-full object-cover" style="object-position:center center;transform:scale(1.35);transform-origin:center center"/>
      </div>
      <span class="font-black text-lg tracking-tight text-white">ScoreSync</span>
    </a>
    <!-- Nav links -->
    <nav class="hidden md:flex items-center gap-1">
      <a href="#features" class="px-3 py-2 text-sm font-medium rounded-lg transition" style="color:#94a3b8" onmouseover="this.style.color='#fff';this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.color='#94a3b8';this.style.background=''">Features</a>
      <a href="#how" class="px-3 py-2 text-sm font-medium rounded-lg transition" style="color:#94a3b8" onmouseover="this.style.color='#fff';this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.color='#94a3b8';this.style.background=''">How it works</a>
    </nav>
    <!-- Actions -->
    <div class="flex items-center gap-2 flex-shrink-0">
      <a href="/login" class="hidden sm:inline-flex items-center px-4 py-2 rounded-xl text-sm font-bold transition"
        style="color:#94a3b8;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.05)"
        onmouseover="this.style.color='#fff';this.style.background='rgba(255,255,255,0.10)'"
        onmouseout="this.style.color='#94a3b8';this.style.background='rgba(255,255,255,0.05)'">Sign In</a>
      <a href="/register" class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-extrabold text-white transition"
        style="background:linear-gradient(135deg,#1d4ed8,#4f46e5);box-shadow:0 4px 12px rgba(37,99,235,0.35)">Get Started</a>
    </div>
  </div>
</header>

<!-- Hero -->
<section class="relative overflow-hidden text-white py-28 px-6" style="background:linear-gradient(140deg,#060e22 0%,#0f2156 35%,#1a4db5 70%,#2563eb 100%)">
  <div class="absolute top-0 left-0 w-96 h-96 rounded-full blur-3xl pointer-events-none" style="background:rgba(255,255,255,0.04);transform:translate(-50%,-50%)"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 rounded-full blur-3xl pointer-events-none" style="background:rgba(96,165,250,0.08);transform:translate(30%,30%)"></div>

  <div class="relative max-w-5xl mx-auto text-center animate-fadeup">
    <div class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-bold mb-8" style="background:rgba(255,255,255,0.10);border:1px solid rgba(255,255,255,0.18)">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="#fbbf24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3" fill="white"/></svg>
      Municipality of Mansalay, Oriental Mindoro
    </div>
    <h1 class="text-5xl sm:text-6xl font-black leading-tight tracking-tight mb-6">
      Automated Tabulation<br/>
      <span class="text-yellow-300">&amp; Event Management</span>
    </h1>
    <p class="text-blue-100 text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
      ScoreSync powers municipal competitions with real-time scoring, transparent tabulation, and instant results — built for Mansalay and beyond.
    </p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/register" class="inline-flex items-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-slate-900 font-black px-8 py-4 rounded-xl shadow-2xl transition text-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>
        Get Started
      </a>
      <a href="/login" class="inline-flex items-center gap-2 text-white font-semibold px-8 py-4 rounded-xl transition text-sm" style="background:rgba(255,255,255,0.10);border:1px solid rgba(255,255,255,0.20)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
        Sign In
      </a>
    </div>
  </div>

  <!-- Stats -->
  <div class="relative max-w-3xl mx-auto mt-16 grid grid-cols-3 gap-4 px-4 animate-fadeup-1">
    <div class="rounded-2xl p-4 text-center" style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12)">
      <div class="text-3xl font-black text-yellow-300">100%</div>
      <div class="text-blue-200 text-xs mt-1 font-medium">Digital Scoring</div>
    </div>
    <div class="rounded-2xl p-4 text-center" style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12)">
      <div class="text-3xl font-black text-emerald-300">Live</div>
      <div class="text-blue-200 text-xs mt-1 font-medium">Real-time Results</div>
    </div>
    <div class="rounded-2xl p-4 text-center" style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12)">
      <div class="text-3xl font-black text-purple-300">3</div>
      <div class="text-blue-200 text-xs mt-1 font-medium">User Roles</div>
    </div>
  </div>
</section>

<!-- Features -->
<section id="features" class="py-24 px-6" style="background:#0d1424">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block text-xs font-bold px-3 py-1 rounded-full mb-4 uppercase tracking-widest"
        style="background:rgba(59,130,246,0.15);color:#93c5fd;border:1px solid rgba(59,130,246,0.25)">Features</span>
      <h2 class="text-4xl font-black tracking-tight" style="color:#f1f5f9">Everything You Need</h2>
      <p class="mt-3 text-base max-w-lg mx-auto" style="color:#475569">Built for pageants, sports fests, talent shows, and any scored competition.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">

      <div class="rounded-2xl p-7 hover:-translate-y-1.5 transition-transform duration-200"
        style="background:#111827;border:1px solid rgba(255,255,255,0.08);box-shadow:0 4px 20px rgba(0,0,0,0.3)">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5 shadow-md" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><polyline points="9 16 11 18 15 14"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e2e8f0">Event Management</h3>
        <p class="text-sm leading-relaxed" style="color:#475569">Create multiple competition events with categories, schedules, venues, prizes, and contestant rosters.</p>
      </div>

      <div class="rounded-2xl p-7 hover:-translate-y-1.5 transition-transform duration-200"
        style="background:#111827;border:1px solid rgba(255,255,255,0.08);box-shadow:0 4px 20px rgba(0,0,0,0.3)">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5 shadow-md" style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e2e8f0">Custom Scoring Criteria</h3>
        <p class="text-sm leading-relaxed" style="color:#475569">Define weighted criteria per event — beauty, talent, intelligence, and any custom category.</p>
      </div>

      <div class="rounded-2xl p-7 hover:-translate-y-1.5 transition-transform duration-200"
        style="background:#111827;border:1px solid rgba(255,255,255,0.08);box-shadow:0 4px 20px rgba(0,0,0,0.3)">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5 shadow-md" style="background:linear-gradient(135deg,#064e3b,#059669)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e2e8f0">Live Tabulation</h3>
        <p class="text-sm leading-relaxed" style="color:#475569">Scores aggregated and ranked in real-time as judges submit. No manual tallying needed.</p>
      </div>

      <div class="rounded-2xl p-7 hover:-translate-y-1.5 transition-transform duration-200"
        style="background:#111827;border:1px solid rgba(255,255,255,0.08);box-shadow:0 4px 20px rgba(0,0,0,0.3)">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5 shadow-md" style="background:linear-gradient(135deg,#1e40af,#3b82f6)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e2e8f0">Role-Based Access</h3>
        <p class="text-sm leading-relaxed" style="color:#475569">Separate portals for Administrators, Judges, and Participants with the right permissions.</p>
      </div>

      <div class="rounded-2xl p-7 hover:-translate-y-1.5 transition-transform duration-200"
        style="background:#111827;border:1px solid rgba(255,255,255,0.08);box-shadow:0 4px 20px rgba(0,0,0,0.3)">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5 shadow-md" style="background:linear-gradient(135deg,#92400e,#d97706)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e2e8f0">Leaderboard &amp; Results</h3>
        <p class="text-sm leading-relaxed" style="color:#475569">Official rankings with podium display and printable tabulation sheets.</p>
      </div>

      <div class="rounded-2xl p-7 hover:-translate-y-1.5 transition-transform duration-200"
        style="background:#111827;border:1px solid rgba(255,255,255,0.08);box-shadow:0 4px 20px rgba(0,0,0,0.3)">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5 shadow-md" style="background:linear-gradient(135deg,#134e4a,#0d9488)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        </div>
        <h3 class="font-bold mb-2" style="color:#e2e8f0">Cloud-Powered</h3>
        <p class="text-sm leading-relaxed" style="color:#475569">Built on Firebase — secure, synced across devices, always available during events.</p>
      </div>

    </div>
  </div>
</section>

<!-- How it works -->
<section id="how" class="py-24 px-6" style="background:#0a0f1e">
  <div class="max-w-4xl mx-auto text-center mb-14">
    <span class="inline-block text-xs font-bold px-3 py-1 rounded-full mb-4 uppercase tracking-widest"
      style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25)">How It Works</span>
    <h2 class="text-4xl font-black tracking-tight" style="color:#f1f5f9">Up &amp; running in minutes</h2>
  </div>
  <div class="max-w-4xl mx-auto grid md:grid-cols-3 gap-8">
    <div class="text-center">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-xl" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
        <span class="text-white font-black text-xl">1</span>
      </div>
      <h3 class="font-bold mb-2" style="color:#e2e8f0">Create an Event</h3>
      <p class="text-sm leading-relaxed" style="color:#475569">Admin sets up the event, adds contestants, defines scoring criteria with weights.</p>
    </div>
    <div class="text-center">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-xl" style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
        <span class="text-white font-black text-xl">2</span>
      </div>
      <h3 class="font-bold mb-2" style="color:#e2e8f0">Judges Score</h3>
      <p class="text-sm leading-relaxed" style="color:#475569">Judges log in and enter scores per contestant per criteria from any device.</p>
    </div>
    <div class="text-center">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-xl" style="background:linear-gradient(135deg,#92400e,#d97706)">
        <span class="text-white font-black text-xl">3</span>
      </div>
      <h3 class="font-bold mb-2" style="color:#e2e8f0">Results Instantly</h3>
      <p class="text-sm leading-relaxed" style="color:#475569">ScoreSync computes weighted averages, ranks contestants, shows official results.</p>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-20 px-6 relative overflow-hidden text-white" style="background:linear-gradient(140deg,#060e22 0%,#0f2156 40%,#1a4db5 80%,#2563eb 100%)">
  <div class="relative max-w-2xl mx-auto text-center">
    <div class="w-16 h-16 rounded-full overflow-hidden flex items-center justify-center mx-auto mb-6 shadow-xl" style="border:3px solid rgba(255,255,255,0.25)">
      <img src="/scoresync-logo.png" alt="ScoreSync" class="w-full h-full object-cover" style="object-position:center center;transform:scale(1.35);transform-origin:center center"/>
    </div>
    <h2 class="text-4xl font-black mb-4 tracking-tight">Ready to run your next competition?</h2>
    <p class="text-blue-100 mb-8 text-base">Join ScoreSync and bring efficiency and transparency to Mansalay's events.</p>
    <div class="flex gap-3 justify-center flex-wrap">
      <a href="/register" class="inline-flex items-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-slate-900 font-black px-10 py-4 rounded-xl shadow-xl transition text-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>
        Start Now
      </a>
      <a href="/login" class="inline-flex items-center gap-2 text-white font-semibold px-8 py-4 rounded-xl transition text-sm" style="background:rgba(255,255,255,0.10);border:1px solid rgba(255,255,255,0.20)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
        Sign In
      </a>
    </div>
  </div>
</section>

{{> footer }}
</body>
</html>

