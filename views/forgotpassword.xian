{{> head }}
<body class="min-h-screen flex items-center justify-center px-4 py-8" style="background:#0a0f1e">

  <div class="w-full max-w-sm animate-fadeup">

    <!-- Logo -->
    <div class="flex flex-col items-center mb-7">
      <div class="w-16 h-16 rounded-full overflow-hidden shadow-2xl mb-4" style="border:3px solid rgba(99,102,241,0.4)">
        <img src="/mansalay-logo.png" alt="ScoreSync" class="w-full h-full object-cover"/>
      </div>
      <h1 class="text-2xl font-black tracking-tight text-white">Reset Password</h1>
      <p class="text-sm mt-1 text-center" style="color:#64748b">Enter your email and we'll send a reset link.</p>
    </div>

    {{#if error_msg}}
    <div class="alert-error mb-4">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/></svg>
      <span>{{error_msg}}</span>
    </div>
    {{/if}}
    {{#if success_msg}}
    <div class="alert-success mb-4">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
      <span>{{success_msg}}</span>
    </div>
    {{/if}}

    <div class="space-y-4">
      <!-- Info box -->
      <div class="flex items-start gap-3 p-4 rounded-2xl" style="background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.2)">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(99,102,241,0.2)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <p class="text-xs leading-relaxed" style="color:#94a3b8">A password reset link will be sent to your registered email address. Check your inbox and spam folder.</p>
      </div>

      <form method="POST" action="/forgot-password" class="space-y-4">
        <div>
          <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider" style="color:#64748b">Email Address</label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#374151">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <input type="email" name="email" placeholder="you@example.com" required
              style="width:100%;padding:14px 14px 14px 44px;border:1.5px solid rgba(255,255,255,0.08);border-radius:16px;font-size:0.9rem;color:#e2e8f0;outline:none;background:rgba(255,255,255,0.05);transition:border-color 0.2s,box-shadow 0.2s"
              onfocus="this.style.borderColor='#6366f1';this.style.boxShadow='0 0 0 3px rgba(99,102,241,0.2)'"
              onblur="this.style.borderColor='rgba(255,255,255,0.08)';this.style.boxShadow='none'"/>
          </div>
        </div>

        <button type="submit"
          class="w-full py-4 rounded-2xl font-extrabold text-base text-white transition hover:opacity-90 active:scale-[0.98]"
          style="background:linear-gradient(135deg,#4f46e5,#6366f1);box-shadow:0 6px 20px rgba(79,70,229,0.4)">
          Send Reset Link →
        </button>
      </form>
    </div>

    <div class="mt-5 text-center">
      <a href="/login" class="inline-flex items-center gap-1.5 text-sm font-semibold" style="color:#818cf8">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Sign In
      </a>
    </div>

  </div>
</body>
</html>
