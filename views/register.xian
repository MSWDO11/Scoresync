{{> head }}
<body class="min-h-screen flex items-center justify-center" style="background:#0a0f1e">

  <!-- ══ Register Panel (centered) ══ -->
  <div class="w-full flex items-center justify-center px-5 py-8 overflow-y-auto">
    <div class="w-full max-w-[440px] animate-fadeup">

      <!-- Register card -->
      <div class="rounded-2xl overflow-hidden shadow-2xl" style="background:#111827;border:1px solid rgba(255,255,255,0.10)">
        <!-- Top accent -->
        <div class="h-1.5" style="background:linear-gradient(90deg,#6366f1,#8b5cf6,#f59e0b)"></div>

        <div class="p-6 sm:p-8">
          <!-- Heading -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0" style="border:2px solid rgba(255,255,255,0.15)">
              <img src="/mansalay-logo.png" alt="Seal" class="w-full h-full object-cover"/>
            </div>
            <div>
              <h1 class="text-xl font-black tracking-tight" style="color:#f1f5f9">Request an Account</h1>
              <p class="text-xs mt-0.5" style="color:#475569">Submit your request for Admin approval.</p>
            </div>
          </div>

          {{#if error_msg}}<div class="alert-error mb-5"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/></svg><span>{{error_msg}}</span></div>{{/if}}
          {{#if success_msg}}<div class="alert-success mb-5"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg><span>{{success_msg}}</span></div>{{/if}}

          <form method="POST" action="/register" class="space-y-4">

            <!-- Name -->
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Full Name</label>
              <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#374151">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <input type="text" name="name" placeholder="Juan dela Cruz" required class="w-full"
                  style="padding:11px 14px 11px 40px;border:1.5px solid rgba(255,255,255,0.10);border-radius:10px;font-size:0.875rem;color:#e2e8f0;outline:none;background:#1e293b;"
                  onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.20)'"
                  onblur="this.style.borderColor='rgba(255,255,255,0.10)';this.style.boxShadow='none'"/>
              </div>
            </div>

            <!-- Email -->
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Email Address</label>
              <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#374151">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </span>
                <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="w-full"
                  style="padding:11px 14px 11px 40px;border:1.5px solid rgba(255,255,255,0.10);border-radius:10px;font-size:0.875rem;color:#e2e8f0;outline:none;background:#1e293b;"
                  onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.20)'"
                  onblur="this.style.borderColor='rgba(255,255,255,0.10)';this.style.boxShadow='none'"/>
              </div>
            </div>

            <!-- Password -->
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Password</label>
              <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#374151">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <input type="password" name="password" id="passwordInput" placeholder="Min. 6 characters" required minlength="6" autocomplete="new-password" class="w-full"
                  style="padding:11px 42px 11px 40px;border:1.5px solid rgba(255,255,255,0.10);border-radius:10px;font-size:0.875rem;color:#e2e8f0;outline:none;background:#1e293b;"
                  onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.20)'"
                  onblur="this.style.borderColor='rgba(255,255,255,0.10)';this.style.boxShadow='none'"/>
                <button type="button" id="eyeBtn" onclick="togglePassword()" class="absolute right-3.5 top-1/2 -translate-y-1/2 transition" style="color:#374151">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>

            <!-- Role Selection -->
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-2" style="color:#4b5563">Select Role</label>
              <div class="grid grid-cols-2 gap-2.5">

                <!-- Judge -->
                <label class="cursor-pointer">
                  <input type="radio" name="role" value="judge" class="sr-only peer" required/>
                  <div class="peer-checked:ring-2 peer-checked:ring-purple-500 rounded-xl p-3 text-center transition"
                    style="background:#1e293b;border:1.5px solid rgba(255,255,255,0.08)"
                    onmouseover="if(!this.previousElementSibling.checked)this.style.borderColor='rgba(139,92,246,0.4)'"
                    onmouseout="if(!this.previousElementSibling.checked)this.style.borderColor='rgba(255,255,255,0.08)'">
                    <div class="w-9 h-9 grad-purple rounded-xl flex items-center justify-center mx-auto mb-2 shadow-sm">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                    </div>
                    <div class="font-bold text-sm" style="color:#e2e8f0">Judge</div>
                    <div class="text-[11px] mt-0.5" style="color:#4b5563">Score contestants</div>
                  </div>
                </label>

                <!-- Participant -->
                <label class="cursor-pointer">
                  <input type="radio" name="role" value="encoder" class="sr-only peer"/>
                  <div class="peer-checked:ring-2 peer-checked:ring-emerald-500 rounded-xl p-3 text-center transition"
                    style="background:#1e293b;border:1.5px solid rgba(255,255,255,0.08)">
                    <div class="w-9 h-9 grad-green rounded-xl flex items-center justify-center mx-auto mb-2 shadow-sm">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                    </div>
                    <div class="font-bold text-sm" style="color:#e2e8f0">Participant</div>
                    <div class="text-[11px] mt-0.5" style="color:#4b5563">Manage contestants</div>
                  </div>
                </label>

                <!-- Organizer (full width) -->
                <label class="cursor-pointer col-span-2">
                  <input type="radio" name="role" value="organizer" class="sr-only peer"/>
                  <div class="peer-checked:ring-2 peer-checked:ring-amber-500 rounded-xl p-3 flex items-center gap-3 transition"
                    style="background:#1e293b;border:1.5px solid rgba(255,255,255,0.08)">
                    <div class="w-9 h-9 grad-gold rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><line x1="12" y1="3" x2="12" y2="7"/></svg>
                    </div>
                    <div class="text-left">
                      <div class="font-bold text-sm" style="color:#e2e8f0">Organizer</div>
                      <div class="text-[11px]" style="color:#4b5563">Create events, track income &amp; manage</div>
                    </div>
                    <div class="ml-auto flex-shrink-0">
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold" style="background:rgba(245,158,11,0.15);color:#fbbf24;border:1px solid rgba(245,158,11,0.3)">NEW</span>
                    </div>
                  </div>
                </label>

              </div>
            </div>

            <!-- Submit -->
            <button type="submit" class="w-full flex items-center justify-center gap-2 py-3 rounded-xl font-bold text-sm text-white transition hover:opacity-90 active:scale-95 mt-2"
              style="background:linear-gradient(135deg,#4f46e5,#6366f1);box-shadow:0 4px 14px rgba(79,70,229,0.4)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
              Request Account
            </button>

          </form>
        </div>
      </div>

      <p class="text-center text-sm mt-5" style="color:#374151">
        Already have an account?
        <a href="/login" class="font-bold hover:underline ml-1" style="color:#60a5fa">Sign in</a>
      </p>
      <p class="text-center mt-3">
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold hover:underline" style="color:#374151">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          Back to Home
        </a>
      </p>
    </div>
  </div>

<script>
const eyeOpen='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeClose='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePassword(){
  const i=document.getElementById('passwordInput'),b=document.getElementById('eyeBtn');
  if(i.type==='password'){i.type='text';b.innerHTML=eyeClose;}
  else{i.type='password';b.innerHTML=eyeOpen;}
}
// Highlight selected role card border
document.querySelectorAll('input[name="role"]').forEach(radio => {
  radio.addEventListener('change', () => {
    document.querySelectorAll('input[name="role"]').forEach(r => {
      const div = r.nextElementSibling;
      if (r.checked) {
        const colors = {judge:'rgba(139,92,246,0.4)',encoder:'rgba(16,185,129,0.4)',organizer:'rgba(245,158,11,0.4)'};
        div.style.borderColor = colors[r.value] || 'rgba(255,255,255,0.3)';
      } else {
        div.style.borderColor = 'rgba(255,255,255,0.08)';
      }
    });
  });
});

// Auto-select role from URL query string or server-passed preRole
(function() {
  const preRole = "{{preRole}}" || new URLSearchParams(window.location.search).get('role');
  if (preRole) {
    const radio = document.querySelector('input[name="role"][value="' + preRole + '"]');
    if (radio) {
      radio.checked = true;
      radio.dispatchEvent(new Event('change'));
      radio.closest('.cursor-pointer')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }
})();
</script>
</body>
</html>
