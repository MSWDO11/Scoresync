{{> head }}
<body class="min-h-screen flex items-center justify-center" style="background:#0a0f1e">

  <!-- ══ Login Panel (centered) ══ -->
  <div class="w-full flex items-center justify-center px-5 py-10">
    <div class="w-full max-w-[420px] animate-fadeup">

      <!-- Login card -->
      <div class="rounded-2xl overflow-hidden shadow-2xl" style="background:#111827;border:1px solid rgba(255,255,255,0.10)">

        <!-- Card header accent -->
        <div class="h-1.5" style="background:linear-gradient(90deg,#1d4ed8,#6366f1,#8b5cf6)"></div>

        <div class="p-7 sm:p-8">
          <!-- Heading with seal -->
          <div class="flex items-center gap-3 mb-7">
            <div class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0" style="border:2px solid rgba(255,255,255,0.15)">
              <img src="/mansalay-logo.png" alt="Seal" class="w-full h-full object-cover"/>
            </div>
            <div>
              <h1 class="text-xl font-black tracking-tight" style="color:#f1f5f9">Welcome back</h1>
              <p class="text-xs mt-0.5" style="color:#475569">Sign in to your ScoreSync account.</p>
            </div>
          </div>

          {{#if error_msg}}
          <div class="alert-error mb-5">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>{{error_msg}}</span>
          </div>
          {{/if}}
          {{#if success_msg}}
          <div class="alert-success mb-5">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{{success_msg}}</span>
          </div>
          {{/if}}

          <form method="POST" action="/login" class="space-y-5">

            <!-- Email -->
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-2" style="color:#4b5563">Email Address</label>
              <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#374151">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </span>
                <input type="email" name="email" placeholder="you@example.com" required autocomplete="email"
                  class="w-full"
                  style="padding:11px 14px 11px 40px;border:1.5px solid rgba(255,255,255,0.10);border-radius:10px;font-size:0.875rem;color:#e2e8f0;outline:none;background:#1e293b;"
                  onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.20)'"
                  onblur="this.style.borderColor='rgba(255,255,255,0.10)';this.style.boxShadow='none'"/>
              </div>
            </div>

            <!-- Password -->
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-2" style="color:#4b5563">Password</label>
              <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#374151">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <input type="password" name="password" id="passwordInput" placeholder="••••••••" required autocomplete="current-password"
                  class="w-full"
                  style="padding:11px 42px 11px 40px;border:1.5px solid rgba(255,255,255,0.10);border-radius:10px;font-size:0.875rem;color:#e2e8f0;outline:none;background:#1e293b;"
                  onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.20)'"
                  onblur="this.style.borderColor='rgba(255,255,255,0.10)';this.style.boxShadow='none'"/>
                <button type="button" id="eyeBtn" onclick="togglePassword()"
                  class="absolute right-3.5 top-1/2 -translate-y-1/2 transition" style="color:#374151">
                  <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>

            <!-- Remember + Forgot -->
            <div class="flex items-center justify-between">
              <label class="flex items-center gap-2 text-sm cursor-pointer select-none" style="color:#64748b">
                <input type="checkbox" class="w-4 h-4 rounded" style="accent-color:#3b82f6"> Remember me
              </label>
              <a href="/forgot-password" class="text-xs font-semibold hover:underline" style="color:#60a5fa">Forgot password?</a>
            </div>

            <!-- Submit -->
            <button type="submit" class="w-full flex items-center justify-center gap-2 py-3 rounded-xl font-bold text-sm text-white transition hover:opacity-90 active:scale-95"
              style="background:linear-gradient(135deg,#1d4ed8,#4f46e5);box-shadow:0 4px 14px rgba(37,99,235,0.4)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
              Sign In
            </button>

          </form>
        </div>
      </div>

      <p class="text-center text-sm mt-5" style="color:#374151">
        Don't have an account?
        <a href="/register" class="font-bold hover:underline ml-1" style="color:#60a5fa">Register here</a>
      </p>
      <p class="text-center mt-3">
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold hover:underline" style="color:#374151">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          Back to Home
        </a>
      </p>
    </div>
  </div>

<script>
const eyeOpen='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeClose='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePassword(){
  const i=document.getElementById('passwordInput'),b=document.getElementById('eyeBtn');
  if(i.type==='password'){i.type='text';b.innerHTML=eyeClose;}
  else{i.type='password';b.innerHTML=eyeOpen;}
}
</script>
</body>
</html>
