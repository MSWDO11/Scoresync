{{> head }}
<body class="min-h-screen flex items-center justify-center px-4 py-8" style="background:#0a0f1e">

  <div class="w-full max-w-sm animate-fadeup">

    <!-- Logo -->
    <div class="flex flex-col items-center mb-6">
      <div class="w-16 h-16 rounded-full overflow-hidden shadow-2xl mb-4" style="border:3px solid rgba(99,102,241,0.4)">
        <img src="/mansalay-logo.png" alt="ScoreSync" class="w-full h-full object-cover"/>
      </div>
      <h1 class="text-2xl font-black tracking-tight text-white">Welcome Back</h1>
      <p class="text-sm mt-1 text-center" style="color:#64748b">Sign in to your ScoreSync account.</p>
    </div>

    <!-- Tab switcher -->
    <div class="flex rounded-2xl p-1 mb-6" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08)">
      <a href="/login" class="flex-1 py-2.5 rounded-xl text-sm font-extrabold text-center text-white transition"
        style="background:linear-gradient(135deg,#4f46e5,#6366f1);box-shadow:0 4px 12px rgba(79,70,229,0.4)">
        Sign In
      </a>
      <a href="/register" class="flex-1 py-2.5 rounded-xl text-sm font-extrabold text-center transition"
        style="color:#64748b">
        Register
      </a>
    </div>

    {{#if error_msg}}
    <div class="alert-error mb-4">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>{{error_msg}}</span>
    </div>
    {{/if}}
    {{#if success_msg}}
    <div class="alert-success mb-4">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
      <span>{{success_msg}}</span>
    </div>
    {{/if}}

    <!-- Form -->
    <form method="POST" action="/login" class="space-y-4">

      <!-- Email -->
      <div>
        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider" style="color:#64748b">Email Address</label>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#374151">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <input type="email" name="email" placeholder="you@example.com" required autocomplete="email"
            style="width:100%;padding:14px 14px 14px 44px;border:1.5px solid rgba(255,255,255,0.08);border-radius:16px;font-size:0.9rem;color:#e2e8f0;outline:none;background:rgba(255,255,255,0.05);transition:border-color 0.2s,box-shadow 0.2s"
            onfocus="this.style.borderColor='#6366f1';this.style.boxShadow='0 0 0 3px rgba(99,102,241,0.2)'"
            onblur="this.style.borderColor='rgba(255,255,255,0.08)';this.style.boxShadow='none'"/>
        </div>
      </div>

      <!-- Password -->
      <div>
        <label class="block text-xs font-bold mb-1.5 uppercase tracking-wider" style="color:#64748b">Password</label>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" style="color:#374151">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </span>
          <input type="password" name="password" id="passwordInput" placeholder="••••••••" required autocomplete="current-password"
            style="width:100%;padding:14px 48px 14px 44px;border:1.5px solid rgba(255,255,255,0.08);border-radius:16px;font-size:0.9rem;color:#e2e8f0;outline:none;background:rgba(255,255,255,0.05);transition:border-color 0.2s,box-shadow 0.2s"
            onfocus="this.style.borderColor='#6366f1';this.style.boxShadow='0 0 0 3px rgba(99,102,241,0.2)'"
            onblur="this.style.borderColor='rgba(255,255,255,0.08)';this.style.boxShadow='none'"/>
          <button type="button" id="eyeBtn" onclick="togglePassword()"
            class="absolute right-4 top-1/2 -translate-y-1/2 transition" style="color:#374151">
            <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <!-- Remember + Forgot -->
      <div class="flex items-center justify-between">
        <label class="flex items-center gap-2 text-sm cursor-pointer select-none" style="color:#64748b">
          <input type="checkbox" class="w-4 h-4 rounded" style="accent-color:#6366f1"> Remember me
        </label>
        <a href="/forgot-password" class="text-xs font-semibold" style="color:#818cf8">Forgot password?</a>
      </div>

      <!-- Submit -->
      <button type="submit"
        class="w-full py-4 rounded-2xl font-extrabold text-base text-white transition hover:opacity-90 active:scale-[0.98] mt-2"
        style="background:linear-gradient(135deg,#4f46e5,#6366f1);box-shadow:0 6px 20px rgba(79,70,229,0.4)">
        Sign In →
      </button>

    </form>

    <!-- Footer links -->
    <div class="mt-5 text-center space-y-2">
      <p class="text-sm" style="color:#374151">
        Don't have an account?
        <a href="/register" class="font-bold ml-1" style="color:#818cf8">Register here</a>
      </p>
      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold" style="color:#374151">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Home
      </a>
    </div>

  </div>

<script>
const eyeOpen='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeClose='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePassword(){
  const i=document.getElementById('passwordInput'),b=document.getElementById('eyeBtn');
  if(i.type==='password'){i.type='text';b.innerHTML=eyeClose;}
  else{i.type='password';b.innerHTML=eyeOpen;}
}
</script>
</body>
</html>
