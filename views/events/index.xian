{{> head }}
<body class="min-h-screen flex flex-col" style="background:#0a0f1e">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <div class="flex items-center justify-between gap-4 animate-fadeup">
    <div class="page-header mb-0">
      <h1>Events</h1>
      <p>All competition events in ScoreSync.</p>
    </div>
    {{#if isAdmin}}
    <a href="/events/create" class="btn-primary text-sm flex-shrink-0">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Event
    </a>
    {{/if}}
  </div>

  {{#if events.length}}
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-5 animate-fadeup-1">
    {{#each events}}
    <div class="overflow-hidden flex flex-col rounded-2xl transition hover:-translate-y-1 hover:shadow-2xl"
      style="background:#111827;border:1px solid rgba(255,255,255,0.08);box-shadow:0 2px 12px rgba(0,0,0,0.3)">
      <!-- Card Header -->
      <div class="px-5 py-4 relative overflow-hidden"
        style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
        <div class="absolute top-0 right-0 w-24 h-24 rounded-full translate-x-8 -translate-y-8" style="background:rgba(255,255,255,0.06)"></div>
        <div class="relative flex items-start justify-between gap-2">
          <div class="flex-1 min-w-0">
            <span class="text-[10px] font-bold uppercase tracking-widest capitalize" style="color:rgba(147,197,253,0.8)">{{#if (eq type 'other')}}{{#if otherType}}{{otherType}}{{else}}Other{{/if}}{{else}}{{type}}{{/if}}</span>
            <h3 class="text-white font-extrabold text-base leading-tight mt-0.5 truncate">{{name}}</h3>
          </div>
          <span class="badge flex-shrink-0 mt-1 {{#if (eq status 'ongoing')}}badge-green{{else}}{{#if (eq status 'completed')}}badge-blue{{else}}{{#if (eq status 'cancelled')}}badge-red{{else}}badge-yellow{{/if}}{{/if}}{{/if}} capitalize">{{status}}</span>
        </div>
      </div>

      <!-- Card Body -->
      <div class="px-5 py-4 flex-1 flex flex-col">
        <div class="space-y-1.5 text-sm flex-1" style="color:#64748b">
          {{#if venue}}
          <div class="flex items-center gap-2">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="truncate">{{venue}}</span>
          </div>
          {{/if}}
          {{#if date}}
          <div class="flex items-center gap-2">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>{{date}}{{#if time}} at {{time}}{{/if}}</span>
          </div>
          {{/if}}
        </div>

        <div class="flex flex-wrap gap-2 mt-4 pt-4" style="border-top:1px solid rgba(255,255,255,0.06)">
          <a href="/events/{{id}}" class="btn-primary btn-sm flex-1 justify-center py-2">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            View
          </a>
          {{#if ../isAdmin}}
            {{#if (eq status 'upcoming')}}
            <form method="POST" action="/events/{{id}}/status" class="inline flex-1">
              <input type="hidden" name="status" value="ongoing">
              <button type="submit" class="btn-sm w-full justify-center py-2 text-xs font-semibold text-white"
                style="background:linear-gradient(135deg,#059669,#10b981);border:none">
                ▶ Start
              </button>
            </form>
            {{/if}}
            {{#if (eq status 'ongoing')}}
            <form method="POST" action="/events/{{id}}/status" class="inline flex-1" onsubmit="return confirm('Manually end event?')">
              <input type="hidden" name="status" value="completed">
              <button type="submit" class="btn-sm w-full justify-center py-2 text-xs font-semibold text-white"
                style="background:linear-gradient(135deg,#1d4ed8,#2563eb);border:none">
                ✓ End
              </button>
            </form>
            {{/if}}
          <a href="/events/{{id}}/edit" class="btn-sm btn-sm-gray flex-1 justify-center py-2">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit
          </a>
          {{/if}}
        </div>
      </div>
    </div>
    {{/each}}
  </div>

  {{else}}
  <div class="py-20 text-center animate-fadeup-1 rounded-2xl" style="background:#111827;border:1px solid rgba(255,255,255,0.07)">
    <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5"
      style="background:rgba(59,130,246,0.10);border:1px solid rgba(59,130,246,0.15)">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </div>
    <p class="font-semibold text-base mb-1" style="color:#e2e8f0">No events yet</p>
    <p class="text-sm mb-5" style="color:#374151">Create your first competition event to get started.</p>
    {{#if isAdmin}}
    <a href="/events/create" class="btn-primary text-sm">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Create First Event
    </a>
    {{/if}}
  </div>
  {{/if}}

</main>
</div>
{{> footer }}
</body>
</html>
