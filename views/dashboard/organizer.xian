{{> head }}
<body class="min-h-screen flex flex-col" style="background:#0a0f1e">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <!-- ── Header ── -->
  <div class="rounded-2xl p-5 sm:p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-5 relative overflow-hidden animate-fadeup"
    style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
    <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full blur-3xl pointer-events-none" style="background:rgba(217,119,6,0.07)"></div>
    <div class="relative z-10 space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold"
        style="background:rgba(245,158,11,0.15);color:#fcd34d;border:1px solid rgba(245,158,11,0.25)">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z"/></svg>
        Organizer Panel
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight" style="color:#f1f5f9">
        Welcome, <span style="background:linear-gradient(90deg,#fbbf24,#f97316);-webkit-background-clip:text;-webkit-text-fill-color:transparent">{{userName}}</span> 👋
      </h1>
      <p class="text-sm font-medium" style="color:#475569">Manage and oversee your live competition events.</p>
    </div>
    <div class="relative z-10 flex-shrink-0 flex gap-3">
      <a href="/events/create" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-sm text-white transition hover:opacity-90 active:scale-95"
        style="background:linear-gradient(135deg,#b45309,#f59e0b);box-shadow:0 4px 14px rgba(245,158,11,0.35)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Event
      </a>
    </div>
  </div>

  <!-- ── KPI Cards ── -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 animate-fadeup-1">

    <!-- Total Events -->
    <a href="/events" class="relative overflow-hidden rounded-2xl p-4 sm:p-5 text-white transition-all duration-300 hover:-translate-y-1 block"
      style="background:linear-gradient(135deg,#b45309,#d97706,#f59e0b);box-shadow:0 6px 24px rgba(217,119,6,0.3)">
      <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.07)"></div>
      <div class="flex items-start justify-between mb-3 relative z-10">
        <p class="text-[10px] sm:text-xs font-extrabold uppercase tracking-widest" style="color:rgba(253,230,138,0.85)">My Events</p>
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
      </div>
      <p class="text-3xl sm:text-4xl font-black leading-none tracking-tight relative z-10">{{totalEvents}}</p>
      <div class="w-full rounded-full h-1.5 my-3 relative z-10 overflow-hidden" style="background:rgba(255,255,255,0.15)">
        <div class="h-full rounded-full" style="width:70%;background:rgba(255,255,255,0.8)"></div>
      </div>
      <span class="inline-flex items-center gap-1.5 text-xs font-bold relative z-10" style="color:rgba(253,230,138,0.9)">
        View all events
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </span>
    </a>

    <!-- Ongoing (Live Now) -->
    <div class="relative overflow-hidden rounded-2xl p-4 sm:p-5 text-white transition-all duration-300 hover:-translate-y-1"
      style="background:linear-gradient(135deg,#064e3b,#059669,#10b981);box-shadow:0 6px 24px rgba(5,150,105,0.3)">
      <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.07)"></div>
      <div class="flex items-start justify-between mb-3 relative z-10">
        <p class="text-[10px] sm:text-xs font-extrabold uppercase tracking-widest" style="color:rgba(110,231,183,0.85)">Live Now</p>
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        </div>
      </div>
      <p class="text-3xl sm:text-4xl font-black leading-none tracking-tight relative z-10 flex items-center gap-2">
        {{ongoingCount}}
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-300 animate-ping"></span>
      </p>
      <div class="w-full rounded-full h-1.5 my-3 relative z-10 overflow-hidden" style="background:rgba(255,255,255,0.15)">
        <div class="h-full rounded-full" style="width:{{ongoingCount}}0%;background:rgba(255,255,255,0.8)"></div>
      </div>
      <span class="inline-flex items-center gap-1.5 text-xs font-bold relative z-10" style="color:rgba(110,231,183,0.9)">
        Ongoing events below
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </span>
    </div>

    <!-- Judges -->
    <div class="relative overflow-hidden rounded-2xl p-4 sm:p-5 text-white transition-all duration-300 hover:-translate-y-1"
      style="background:linear-gradient(135deg,#1e3a8a,#1d4ed8,#3b82f6);box-shadow:0 6px 24px rgba(37,99,235,0.3)">
      <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.07)"></div>
      <div class="flex items-start justify-between mb-3 relative z-10">
        <p class="text-[10px] sm:text-xs font-extrabold uppercase tracking-widest" style="color:rgba(147,197,253,0.85)">Judges</p>
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
      </div>
      <p class="text-3xl sm:text-4xl font-black leading-none tracking-tight relative z-10">{{judges.length}}</p>
      <div class="w-full rounded-full h-1.5 my-3 relative z-10 overflow-hidden" style="background:rgba(255,255,255,0.15)">
        <div class="h-full rounded-full" style="width:60%;background:rgba(255,255,255,0.8)"></div>
      </div>
      <span class="inline-flex items-center gap-1.5 text-xs font-bold relative z-10" style="color:rgba(147,197,253,0.9)">
        Active judges
      </span>
    </div>

    <!-- Finance -->
    <a href="/events" class="relative overflow-hidden rounded-2xl p-4 sm:p-5 text-white transition-all duration-300 hover:-translate-y-1 block"
      style="background:linear-gradient(135deg,#4c1d95,#6d28d9,#8b5cf6);box-shadow:0 6px 24px rgba(109,40,217,0.3)">
      <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.07)"></div>
      <div class="flex items-start justify-between mb-3 relative z-10">
        <p class="text-[10px] sm:text-xs font-extrabold uppercase tracking-widest" style="color:rgba(196,181,253,0.85)">Finance</p>
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
      </div>
      <p class="text-xl font-black leading-none tracking-tight relative z-10 mt-1">Income &amp; Expenses</p>
      <p class="text-xs mt-1 relative z-10" style="color:rgba(196,181,253,0.7)">Track event finances</p>
      <span class="inline-flex items-center gap-1.5 text-xs font-bold relative z-10 mt-3" style="color:rgba(196,181,253,0.9)">
        View events
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </span>
    </a>

  </div>

  <!-- ── Ongoing Events (main section) ── -->
  <div class="animate-fadeup-2 space-y-4">

    <div class="flex items-center justify-between px-1">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
        <h2 class="font-extrabold text-base tracking-tight" style="color:#e2e8f0">Live / Ongoing Events</h2>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25)">{{ongoingCount}} active</span>
      </div>
      <a href="/events" class="text-xs font-bold flex items-center gap-1 transition" style="color:#fbbf24">
        All Events
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    {{#if ongoingEvents.length}}
    <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 xl:grid-cols-3">
      {{#each ongoingEvents}}
      <div class="rounded-2xl overflow-hidden flex flex-col transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
        style="background:#111827;border:1px solid rgba(16,185,129,0.2);box-shadow:0 4px 20px rgba(0,0,0,0.4)">

        <!-- Event card header -->
        <div class="px-5 py-4 relative overflow-hidden" style="background:{{themeGradient theme}}">
          <div class="absolute -right-4 -top-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.05)"></div>
          <div class="relative flex items-start justify-between gap-2">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping flex-shrink-0"></span>
                <span class="text-[10px] font-extrabold uppercase tracking-widest" style="color:rgba(110,231,183,0.8)">Ongoing</span>
              </div>
              <h3 class="font-extrabold text-white text-sm leading-snug truncate">{{name}}</h3>
              {{#if venue}}<p class="text-[11px] mt-0.5 truncate" style="color:rgba(110,231,183,0.65)">📍 {{venue}}</p>{{/if}}
            </div>
            <span class="flex-shrink-0 px-2.5 py-1 rounded-lg text-[10px] font-extrabold capitalize"
              style="background:rgba(255,255,255,0.12);color:#fff;border:1px solid rgba(255,255,255,0.15)">{{#if (eq type 'other')}}{{#if otherType}}{{otherType}}{{else}}Other{{/if}}{{else}}{{type}}{{/if}}</span>
          </div>
          {{#if date}}
          <div class="mt-2 flex items-center gap-1.5 text-[11px]" style="color:rgba(110,231,183,0.7)">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {{date}}{{#if time}} at {{time}}{{/if}}
          </div>
          {{/if}}
        </div>

        <!-- Action buttons — 2 col, full width on mobile -->
        <div class="px-4 py-3 grid grid-cols-2 gap-2" style="border-bottom:1px solid rgba(255,255,255,0.06)">
          <a href="/events/{{id}}"
            class="flex items-center justify-center gap-1.5 py-2.5 rounded-xl text-xs font-bold transition active:scale-95 min-w-0"
            style="background:rgba(16,185,129,0.12);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25)"
            onmouseover="this.style.background='rgba(16,185,129,0.22)'" onmouseout="this.style.background='rgba(16,185,129,0.12)'">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            View Event
          </a>
          <a href="/events/{{id}}/edit"
            class="flex items-center justify-center gap-1.5 py-2.5 rounded-xl text-xs font-bold transition active:scale-95 min-w-0"
            style="background:rgba(245,158,11,0.12);color:#fbbf24;border:1px solid rgba(245,158,11,0.25)"
            onmouseover="this.style.background='rgba(245,158,11,0.22)'" onmouseout="this.style.background='rgba(245,158,11,0.12)'">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit
          </a>
          <a href="/events/{{id}}/contestants/add"
            class="flex items-center justify-center gap-1.5 py-2.5 rounded-xl text-xs font-bold transition active:scale-95 min-w-0"
            style="background:rgba(59,130,246,0.12);color:#93c5fd;border:1px solid rgba(59,130,246,0.25)"
            onmouseover="this.style.background='rgba(59,130,246,0.22)'" onmouseout="this.style.background='rgba(59,130,246,0.12)'">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            Add Contestant
          </a>
          <a href="/events/{{id}}/criteria"
            class="flex items-center justify-center gap-1.5 py-2.5 rounded-xl text-xs font-bold transition active:scale-95 min-w-0"
            style="background:rgba(139,92,246,0.12);color:#c4b5fd;border:1px solid rgba(139,92,246,0.25)"
            onmouseover="this.style.background='rgba(139,92,246,0.22)'" onmouseout="this.style.background='rgba(139,92,246,0.12)'">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            Add Criteria
          </a>
        </div>

        <!-- Results + End Event row -->
        <div class="px-4 py-3 grid grid-cols-2 gap-2" style="border-bottom:1px solid rgba(255,255,255,0.06)">
          <a href="/events/{{id}}/results"
            class="flex items-center justify-center gap-1.5 py-2.5 rounded-xl text-xs font-bold transition active:scale-95 min-w-0"
            style="background:rgba(16,185,129,0.08);color:#6ee7b7;border:1px solid rgba(16,185,129,0.15)"
            onmouseover="this.style.background='rgba(16,185,129,0.18)'" onmouseout="this.style.background='rgba(16,185,129,0.08)'">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            Live Results
          </a>
          <form method="POST" action="/events/{{id}}/status" class="w-full"
            onsubmit="return confirm('End this event and mark as completed?')">
            <input type="hidden" name="status" value="completed">
            <button type="submit"
              class="w-full flex items-center justify-center gap-1.5 py-2.5 rounded-xl text-xs font-bold transition active:scale-95"
              style="background:rgba(239,68,68,0.12);color:#fca5a5;border:1px solid rgba(239,68,68,0.25)"
              onmouseover="this.style.background='rgba(239,68,68,0.25)'" onmouseout="this.style.background='rgba(239,68,68,0.12)'">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              End Event
            </button>
          </form>
        </div>

        <!-- Judges panel -->
        <div class="px-4 py-3 flex-1">
          <div class="flex items-center gap-1.5 mb-2">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span class="text-[10px] font-extrabold uppercase tracking-wider" style="color:#475569">Active Judges</span>
          </div>
          {{#if ../judges.length}}
          <div class="flex flex-wrap gap-1.5">
            {{#each ../judges}}
            <div class="flex items-center gap-1.5 px-2 py-1 rounded-lg text-[11px] font-semibold"
              style="background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.15);color:#93c5fd">
              <div class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-extrabold text-white flex-shrink-0"
                style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">{{initial}}</div>
              {{alias}}
            </div>
            {{/each}}
          </div>
          {{else}}
          <p class="text-[11px]" style="color:#374151">No judges assigned yet.</p>
          {{/if}}
        </div>

      </div>
      {{/each}}
    </div>

    {{else}}
    <!-- No ongoing events -->
    <div class="rounded-2xl py-16 text-center px-4 flex flex-col items-center justify-center"
      style="background:#111827;border:1px solid rgba(255,255,255,0.06)">
      <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4"
        style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15)">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
      </div>
      <h3 class="font-bold text-sm mb-1" style="color:#e2e8f0">No live events right now</h3>
      <p class="text-xs mb-5 max-w-xs mx-auto" style="color:#374151">There are no ongoing events at the moment. Start an upcoming event or create a new one.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/events" class="btn-sm btn-sm-green text-xs">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          All Events
        </a>
        <a href="/events/create" class="btn-primary text-sm">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Create Event
        </a>
      </div>
    </div>
    {{/if}}

  </div>

  <!-- ── Quick Actions + Judges List side by side ── -->
  <div class="grid lg:grid-cols-3 gap-5 animate-fadeup-2">

    <!-- Quick Actions (2/3) -->
    <div class="lg:col-span-2 rounded-2xl overflow-hidden" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
      <div class="px-5 py-4 flex items-center gap-2.5"
        style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(255,255,255,0.02)">
        <div class="w-7 h-7 rounded-lg flex items-center justify-center"
          style="background:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.3)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="#fbbf24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <h2 class="text-sm font-extrabold tracking-tight" style="color:#e2e8f0">Quick Actions</h2>
      </div>
      <div class="p-3 grid grid-cols-1 sm:grid-cols-2 gap-1">

        <a href="/events/create" class="flex items-center gap-3 p-3 rounded-xl transition"
          style="border:1px solid transparent"
          onmouseover="this.style.background='rgba(245,158,11,0.08)';this.style.borderColor='rgba(245,158,11,0.15)'"
          onmouseout="this.style.background='';this.style.borderColor='transparent'">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-white shadow-sm"
            style="background:linear-gradient(135deg,#b45309,#d97706)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-bold" style="color:#e2e8f0">Create Event</div>
            <div class="text-[11px]" style="color:#374151">Set up a new competition</div>
          </div>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/events" class="flex items-center gap-3 p-3 rounded-xl transition"
          style="border:1px solid transparent"
          onmouseover="this.style.background='rgba(59,130,246,0.07)';this.style.borderColor='rgba(59,130,246,0.15)'"
          onmouseout="this.style.background='';this.style.borderColor='transparent'">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-white shadow-sm"
            style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-bold" style="color:#e2e8f0">Manage All Events</div>
            <div class="text-[11px]" style="color:#374151">View, edit &amp; delete events</div>
          </div>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/inventory" class="flex items-center gap-3 p-3 rounded-xl transition"
          style="border:1px solid transparent"
          onmouseover="this.style.background='rgba(16,185,129,0.07)';this.style.borderColor='rgba(16,185,129,0.15)'"
          onmouseout="this.style.background='';this.style.borderColor='transparent'">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-white shadow-sm"
            style="background:linear-gradient(135deg,#064e3b,#059669)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-bold" style="color:#e2e8f0">Ticket Sales &amp; Income</div>
            <div class="text-[11px]" style="color:#374151">Track revenue per event</div>
          </div>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/settings" class="flex items-center gap-3 p-3 rounded-xl transition"
          style="border:1px solid transparent"
          onmouseover="this.style.background='rgba(139,92,246,0.07)';this.style.borderColor='rgba(139,92,246,0.15)'"
          onmouseout="this.style.background='';this.style.borderColor='transparent'">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-white shadow-sm"
            style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-bold" style="color:#e2e8f0">Settings</div>
            <div class="text-[11px]" style="color:#374151">Account &amp; preferences</div>
          </div>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

      </div>
    </div>

    <!-- Judges Panel (1/3) -->
    <div class="rounded-2xl overflow-hidden" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
      <div class="px-5 py-4 flex items-center justify-between"
        style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(255,255,255,0.02)">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg flex items-center justify-center"
            style="background:rgba(59,130,246,0.2);border:1px solid rgba(59,130,246,0.3)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h2 class="text-sm font-extrabold tracking-tight" style="color:#e2e8f0">All Judges</h2>
        </div>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold"
          style="background:rgba(59,130,246,0.12);color:#93c5fd;border:1px solid rgba(59,130,246,0.2)">{{judges.length}}</span>
      </div>

      {{#if judges.length}}
      <div class="divide-y" style="border-color:rgba(255,255,255,0.05)">
        {{#each judges}}
        <div class="flex items-center gap-3 px-4 py-3 transition"
          onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
          <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-extrabold flex-shrink-0 shadow"
            style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">{{initial}}</div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-bold truncate" style="color:#e2e8f0">{{alias}}</div>
            <div class="text-[10px] truncate" style="color:#475569">Active judge</div>
          </div>
          <span class="flex-shrink-0 w-2 h-2 rounded-full bg-emerald-400"></span>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="py-10 text-center px-4">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.5" class="mx-auto mb-3"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <p class="text-xs font-semibold" style="color:#475569">No judges registered yet.</p>
      </div>
      {{/if}}

      <!-- Role info -->
      <div class="px-4 py-4 mt-1" style="border-top:1px solid rgba(255,255,255,0.06)">
        <div class="flex items-start gap-3 p-3 rounded-xl" style="background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.15)">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5"
            style="background:linear-gradient(135deg,#b45309,#d97706)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <div>
            <div class="font-extrabold text-xs" style="color:#fbbf24">{{userName}}</div>
            <p class="text-[11px] mt-0.5 leading-relaxed" style="color:#64748b">Organizer · Can manage events, criteria, contestants &amp; finance.</p>
          </div>
        </div>
      </div>
    </div>

  </div>

</main>
</div>
{{> footer }}
</body>
</html>
