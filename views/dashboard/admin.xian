{{> head }}
<body class="min-h-screen flex flex-col" style="background:#0a0f1e">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}

<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <!-- ── Header Banner ── -->
  <div class="rounded-2xl p-5 sm:p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-5 relative overflow-hidden animate-fadeup"
    style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
    <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full blur-3xl pointer-events-none" style="background:rgba(37,99,235,0.07)"></div>
    <div class="relative z-10 space-y-2">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold"
          style="background:rgba(59,130,246,0.15);color:#93c5fd;border:1px solid rgba(59,130,246,0.25)">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span id="today-date">Today</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold"
          style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25)">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
          System Ready
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight" style="color:#f1f5f9">
        Good day, <span style="background:linear-gradient(90deg,#3b82f6,#818cf8);-webkit-background-clip:text;-webkit-text-fill-color:transparent">{{userName}}</span> 👋
      </h1>
      <p class="text-sm font-medium" style="color:#475569">Welcome back to ScoreSync — your central competition management hub.</p>
    </div>
    <div class="relative z-10 flex-shrink-0">
      <a href="/events/create" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-sm text-white transition hover:opacity-90 active:scale-95"
        style="background:linear-gradient(135deg,#1d4ed8,#4f46e5);box-shadow:0 4px 14px rgba(37,99,235,0.35)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Event
      </a>
    </div>
  </div>

  {{#if pendingCount}}
  <div class="p-4 sm:p-5 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 animate-fadeup"
    style="background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25)">
    <div class="flex items-center gap-4">
      <div class="w-11 h-11 rounded-2xl flex items-center justify-center flex-shrink-0 text-white"
        style="background:linear-gradient(135deg,#b45309,#d97706)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div>
        <h3 class="font-extrabold text-sm" style="color:#fcd34d">Pending Registration Requests</h3>
        <p class="text-xs font-medium mt-0.5" style="color:#92400e">{{pendingCount}} new account(s) awaiting approval.</p>
      </div>
    </div>
    <a href="/users" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs text-white flex-shrink-0 transition hover:opacity-90"
      style="background:#d97706">
      Review &amp; Approve
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
  {{/if}}

  <!-- ── KPI Cards ── -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 animate-fadeup-1">

    <div class="relative overflow-hidden rounded-2xl p-4 sm:p-5 text-white transition-all duration-300 hover:-translate-y-1 group"
      style="background:linear-gradient(135deg,#1e3a8a,#1d4ed8,#3b82f6);box-shadow:0 6px 24px rgba(37,99,235,0.3)">
      <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.07)"></div>
      <div class="flex items-start justify-between mb-3 relative z-10">
        <p class="text-[10px] sm:text-xs font-extrabold uppercase tracking-widest" style="color:rgba(147,197,253,0.85)">Total Events</p>
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
      </div>
      <p class="text-3xl sm:text-4xl font-black leading-none tracking-tight relative z-10">{{totalEvents}}</p>
      <div class="w-full rounded-full h-1.5 my-3 relative z-10 overflow-hidden" style="background:rgba(255,255,255,0.15)">
        <div class="h-full rounded-full" style="width:70%;background:rgba(255,255,255,0.8)"></div>
      </div>
      <a href="/events" class="inline-flex items-center gap-1.5 text-xs font-bold relative z-10" style="color:rgba(147,197,253,0.9)">
        Browse all events
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="relative overflow-hidden rounded-2xl p-4 sm:p-5 text-white transition-all duration-300 hover:-translate-y-1 group"
      style="background:linear-gradient(135deg,#064e3b,#059669,#10b981);box-shadow:0 6px 24px rgba(5,150,105,0.3)">
      <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.07)"></div>
      <div class="flex items-start justify-between mb-3 relative z-10">
        <p class="text-[10px] sm:text-xs font-extrabold uppercase tracking-widest" style="color:rgba(110,231,183,0.85)">Active Users</p>
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
      </div>
      <p class="text-3xl sm:text-4xl font-black leading-none tracking-tight relative z-10">{{totalUsers}}</p>
      <div class="w-full rounded-full h-1.5 my-3 relative z-10 overflow-hidden" style="background:rgba(255,255,255,0.15)">
        <div class="h-full rounded-full" style="width:85%;background:rgba(255,255,255,0.8)"></div>
      </div>
      <a href="/users" class="inline-flex items-center gap-1.5 text-xs font-bold relative z-10" style="color:rgba(110,231,183,0.9)">
        Judges, participants &amp; admins
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="relative overflow-hidden rounded-2xl p-4 sm:p-5 text-white transition-all duration-300 hover:-translate-y-1 group"
      style="background:linear-gradient(135deg,#4c1d95,#6d28d9,#8b5cf6);box-shadow:0 6px 24px rgba(109,40,217,0.3)">
      <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.07)"></div>
      <div class="flex items-start justify-between mb-3 relative z-10">
        <p class="text-[10px] sm:text-xs font-extrabold uppercase tracking-widest" style="color:rgba(196,181,253,0.85)">Ongoing</p>
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        </div>
      </div>
      <p class="text-3xl sm:text-4xl font-black leading-none tracking-tight relative z-10 flex items-center gap-2">
        {{ongoingCount}}
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
      </p>
      <div class="w-full rounded-full h-1.5 my-3 relative z-10 overflow-hidden" style="background:rgba(255,255,255,0.15)">
        <div class="h-full rounded-full" style="width:40%;background:rgba(255,255,255,0.8)"></div>
      </div>
      <a href="/events" class="inline-flex items-center gap-1.5 text-xs font-bold relative z-10" style="color:rgba(196,181,253,0.9)">
        Real-time tabulator
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="relative overflow-hidden rounded-2xl p-4 sm:p-5 text-white transition-all duration-300 hover:-translate-y-1 group"
      style="background:linear-gradient(135deg,#b45309,#d97706,#f59e0b);box-shadow:0 6px 24px rgba(217,119,6,0.3)">
      <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.07)"></div>
      <div class="flex items-start justify-between mb-3 relative z-10">
        <p class="text-[10px] sm:text-xs font-extrabold uppercase tracking-widest" style="color:rgba(253,230,138,0.85)">Quick Launch</p>
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center" style="background:rgba(255,255,255,0.15)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
        </div>
      </div>
      <p class="text-base sm:text-lg font-black leading-tight relative z-10">Create New Competition</p>
      <p class="text-xs font-medium my-2 relative z-10" style="color:rgba(253,230,138,0.8)">Setup pageant, sports, or cultural scoring rules.</p>
      <a href="/events/create" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition relative z-10"
        style="background:rgba(255,255,255,0.2);color:#fff">
        Launch Wizard
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

  </div>

  <!-- ── Main Grid ── -->
  <div class="grid lg:grid-cols-3 gap-5 sm:gap-6 animate-fadeup-2">

    <!-- Recent Events (2/3) -->
    <div class="lg:col-span-2 rounded-2xl overflow-hidden flex flex-col"
      style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
      <div class="px-5 sm:px-6 py-4 flex items-center justify-between"
        style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(255,255,255,0.02)">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center"
            style="background:rgba(59,130,246,0.2);border:1px solid rgba(59,130,246,0.3)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h2 class="text-sm sm:text-base font-extrabold tracking-tight" style="color:#e2e8f0">Recent Competitions</h2>
        </div>
        <a href="/events" class="text-xs font-bold flex items-center gap-1 transition" style="color:#60a5fa">
          View All
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>

      {{#if recentEvents.length}}
      <div class="overflow-x-auto flex-1">
        <table class="w-full text-left" style="border-collapse:collapse">
          <thead>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.06);background:rgba(255,255,255,0.02)">
              <th class="py-3 px-4 sm:px-6 text-[10px] font-extrabold uppercase tracking-wider" style="color:#374151">Event</th>
              <th class="py-3 px-3 text-[10px] font-extrabold uppercase tracking-wider hidden sm:table-cell" style="color:#374151">Type</th>
              <th class="py-3 px-3 text-[10px] font-extrabold uppercase tracking-wider hidden md:table-cell" style="color:#374151">Date</th>
              <th class="py-3 px-3 text-[10px] font-extrabold uppercase tracking-wider" style="color:#374151">Status</th>
              <th class="py-3 px-4 sm:px-6 text-[10px] font-extrabold uppercase tracking-wider text-right" style="color:#374151">Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each recentEvents}}
            <tr class="transition group" style="border-top:1px solid rgba(255,255,255,0.05)"
              onmouseover="this.style.background='rgba(59,130,246,0.05)'" onmouseout="this.style.background=''">
              <td class="py-3.5 px-4 sm:px-6">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm"
                    style="background:{{themeGradient theme}}">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="#fbbf24"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
                  </div>
                  <div>
                    <a href="/events/{{id}}" class="font-bold text-sm transition" style="color:#e2e8f0">{{name}}</a>
                    {{#if venue}}<div class="text-[11px] mt-0.5 flex items-center gap-1" style="color:#374151">
                      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      {{venue}}
                    </div>{{/if}}
                  </div>
                </div>
              </td>
              <td class="py-3.5 px-3 hidden sm:table-cell">
                <span class="px-2.5 py-1 rounded-lg text-xs font-bold capitalize"
                  style="background:rgba(255,255,255,0.07);color:#94a3b8;border:1px solid rgba(255,255,255,0.08)">{{type}}</span>
              </td>
              <td class="py-3.5 px-3 text-xs font-semibold hidden md:table-cell" style="color:#475569">{{date}}</td>
              <td class="py-3.5 px-3">
                <span class="badge {{#if (eq status 'ongoing')}}badge-green{{else}}{{#if (eq status 'completed')}}badge-blue{{else}}{{#if (eq status 'cancelled')}}badge-red{{else}}badge-yellow{{/if}}{{/if}}{{/if}} capitalize">{{status}}</span>
              </td>
              <td class="py-3.5 px-4 sm:px-6 text-right">
                <div class="flex items-center justify-end gap-1.5">
                  <a href="/events/{{id}}" class="p-2 rounded-lg transition"
                    style="background:rgba(59,130,246,0.12);color:#60a5fa;border:1px solid rgba(59,130,246,0.2)"
                    title="View">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                  <a href="/events/{{id}}/edit" class="p-2 rounded-lg transition hidden sm:flex"
                    style="background:rgba(255,255,255,0.07);color:#94a3b8;border:1px solid rgba(255,255,255,0.10)"
                    title="Edit">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                  <a href="/events/{{id}}/results" class="p-2 rounded-lg transition"
                    style="background:rgba(16,185,129,0.12);color:#6ee7b7;border:1px solid rgba(16,185,129,0.2)"
                    title="Results">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                  </a>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="py-16 text-center px-4 flex-1 flex flex-col items-center justify-center">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4"
          style="background:rgba(59,130,246,0.10);border:1px solid rgba(59,130,246,0.15)">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="12" y1="14" x2="12" y2="18"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
        </div>
        <h3 class="font-bold text-sm mb-1" style="color:#e2e8f0">No events yet</h3>
        <p class="text-xs mb-5" style="color:#374151">Create your first competition event to get started.</p>
        <a href="/events/create" class="btn-primary text-sm">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Create First Event
        </a>
      </div>
      {{/if}}
    </div>

    <!-- Right Column -->
    <div class="space-y-5">

      <!-- Admin Shortcuts -->
      <div class="rounded-2xl overflow-hidden" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
        <div class="px-5 py-4 flex items-center gap-2.5"
          style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(255,255,255,0.02)">
          <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.3)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="#fbbf24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h2 class="text-sm font-extrabold tracking-tight" style="color:#e2e8f0">Admin Shortcuts</h2>
        </div>
        <div class="p-3 space-y-1">
          <a href="/events/create" class="flex items-center gap-3 p-3 rounded-xl transition group"
            style="border:1px solid transparent"
            onmouseover="this.style.background='rgba(59,130,246,0.08)';this.style.borderColor='rgba(59,130,246,0.15)'"
            onmouseout="this.style.background='';this.style.borderColor='transparent'">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-white shadow-sm"
              style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-bold" style="color:#e2e8f0">Create Competition</div>
              <div class="text-[11px]" style="color:#374151">Add new event &amp; venue</div>
            </div>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

          <a href="/events" class="flex items-center gap-3 p-3 rounded-xl transition"
            style="border:1px solid transparent"
            onmouseover="this.style.background='rgba(16,185,129,0.07)';this.style.borderColor='rgba(16,185,129,0.15)'"
            onmouseout="this.style.background='';this.style.borderColor='transparent'">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-white shadow-sm"
              style="background:linear-gradient(135deg,#064e3b,#059669)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-bold" style="color:#e2e8f0">Manage All Events</div>
              <div class="text-[11px]" style="color:#374151">Configure contestants &amp; judges</div>
            </div>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

          <a href="/events" class="flex items-center gap-3 p-3 rounded-xl transition"
            style="border:1px solid transparent"
            onmouseover="this.style.background='rgba(139,92,246,0.07)';this.style.borderColor='rgba(139,92,246,0.15)'"
            onmouseout="this.style.background='';this.style.borderColor='transparent'">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-white shadow-sm"
              style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-bold" style="color:#e2e8f0">Criteria &amp; Weights</div>
              <div class="text-[11px]" style="color:#374151">Setup 100% scoring weights</div>
            </div>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

          <a href="/users" class="flex items-center gap-3 p-3 rounded-xl transition"
            style="border:1px solid transparent"
            onmouseover="this.style.background='rgba(245,158,11,0.07)';this.style.borderColor='rgba(245,158,11,0.15)'"
            onmouseout="this.style.background='';this.style.borderColor='transparent'">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-white shadow-sm"
              style="background:linear-gradient(135deg,#b45309,#d97706)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-bold" style="color:#e2e8f0">User Management</div>
              <div class="text-[11px]" style="color:#374151">Add judges &amp; encoders</div>
            </div>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>

      <!-- System Environment -->
      <div class="rounded-2xl overflow-hidden" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
        <div class="px-5 py-4 flex items-center gap-2.5"
          style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(255,255,255,0.02)">
          <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.10)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h2 class="text-sm font-extrabold tracking-tight" style="color:#e2e8f0">System Environment</h2>
        </div>
        <div class="px-5 py-4 space-y-3 text-xs font-medium">

          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2" style="color:#64748b">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Account Role
            </span>
            <span class="badge badge-blue uppercase tracking-wider text-[10px]">{{userRole}}</span>
          </div>

          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2" style="color:#64748b">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
              Cloud Database
            </span>
            <span class="badge badge-green text-[10px]">Firebase Firestore</span>
          </div>

          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2" style="color:#64748b">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              App Framework
            </span>
            <span class="font-bold" style="color:#e2e8f0">XianFire / Express</span>
          </div>

          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2" style="color:#64748b">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Municipal Unit
            </span>
            <span class="font-bold" style="color:#e2e8f0">Mansalay, Or. Mindoro</span>
          </div>

          <div class="flex items-center justify-between pt-2" style="border-top:1px solid rgba(255,255,255,0.06)">
            <span class="flex items-center gap-2" style="color:#64748b">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
              Tabulator Sync
            </span>
            <span class="inline-flex items-center gap-1.5 font-extrabold text-[11px]" style="color:#6ee7b7">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
              Connected
            </span>
          </div>

        </div>
      </div>

    </div>
  </div>

</main>
</div>
{{> footer }}
<script>
  const d=new Date();
  const days=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const months=['January','February','March','April','May','June','July','August','September','October','November','December'];
  const el=document.getElementById('today-date');
  if(el) el.textContent=days[d.getDay()]+', '+months[d.getMonth()]+' '+d.getDate()+', '+d.getFullYear();
</script>
</body>
</html>
