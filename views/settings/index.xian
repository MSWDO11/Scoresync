{{> head }}
<body class="min-h-screen flex flex-col" style="background:#0a0f1e">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <!-- ── Page Header ── -->
  <div class="rounded-2xl p-5 sm:p-7 relative overflow-hidden animate-fadeup"
    style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
    <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full blur-3xl pointer-events-none" style="background:rgba(99,102,241,0.06)"></div>
    <div class="relative flex items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold"
          style="background:rgba(99,102,241,0.15);color:#a5b4fc;border:1px solid rgba(99,102,241,0.25)">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Account &amp; Preferences
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight" style="color:#f1f5f9">Settings</h1>
        <p class="text-sm" style="color:#475569">Manage your profile, role permissions, and tabulator configurations.</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 sm:gap-6">

    <!-- ── Left: Forms ── -->
    <div class="lg:col-span-2 space-y-5">

      <!-- Profile Card -->
      <div class="rounded-2xl overflow-hidden animate-fadeup-1" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
        <div class="px-6 py-4 flex items-center gap-3" style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(255,255,255,0.02)">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:rgba(59,130,246,0.2);border:1px solid rgba(59,130,246,0.3)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div>
            <h2 class="text-sm font-extrabold" style="color:#e2e8f0">User Profile Settings</h2>
            <p class="text-[11px]" style="color:#374151">Update your account display details</p>
          </div>
        </div>
        <div class="px-6 py-5 space-y-4">
          <form action="/settings/update" method="POST" class="space-y-4">
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Full Display Name</label>
              <input type="text" name="name" value="{{userName}}" required class="form-input-bare w-full"/>
            </div>
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Email Address</label>
              <input type="email" value="{{userEmail}}" disabled class="form-input-bare w-full" style="opacity:0.5;cursor:not-allowed"/>
              <p class="text-[11px] mt-1" style="color:#374151">Email is managed by system authentication.</p>
            </div>
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Assigned Role</label>
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold capitalize"
                style="{{#if isAdmin}}background:rgba(59,130,246,0.15);color:#93c5fd;border:1px solid rgba(59,130,246,0.3){{else}}{{#if isJudge}}background:rgba(139,92,246,0.15);color:#c4b5fd;border:1px solid rgba(139,92,246,0.3){{else}}{{#if isOrganizer}}background:rgba(245,158,11,0.15);color:#fcd34d;border:1px solid rgba(245,158,11,0.3){{else}}background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3){{/if}}{{/if}}{{/if}}">
                <span class="w-2 h-2 rounded-full bg-current"></span>
                {{userRole}}
              </div>
            </div>
            <div class="flex justify-end pt-2">
              <button type="submit" class="btn-primary text-xs px-5 py-2.5">
                Save Profile Changes
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Preferences Card -->
      <div class="rounded-2xl overflow-hidden animate-fadeup-1" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
        <div class="px-6 py-4 flex items-center gap-3" style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(255,255,255,0.02)">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:rgba(16,185,129,0.2);border:1px solid rgba(16,185,129,0.3)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </div>
          <div>
            <h2 class="text-sm font-extrabold" style="color:#e2e8f0">Tabulation &amp; Scoring Preferences</h2>
            <p class="text-[11px]" style="color:#374151">Configure score calculation and live leaderboards</p>
          </div>
        </div>
        <div class="px-6 py-5 space-y-3">

          <div class="flex items-center justify-between p-3.5 rounded-xl" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07)">
            <div>
              <p class="text-xs font-bold" style="color:#e2e8f0">Decimal Precision for Final Tally</p>
              <p class="text-[11px] mt-0.5" style="color:#374151">Floating-point rounding for weighted scores.</p>
            </div>
            <select class="form-input-bare text-xs" style="width:auto;padding:6px 28px 6px 10px">
              <option value="2" selected>2 Decimals (98.75)</option>
              <option value="3">3 Decimals (98.750)</option>
              <option value="1">1 Decimal (98.8)</option>
            </select>
          </div>

          <div class="flex items-center justify-between p-3.5 rounded-xl" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07)">
            <div>
              <p class="text-xs font-bold" style="color:#e2e8f0">AI Outlier Alert Threshold</p>
              <p class="text-[11px] mt-0.5" style="color:#374151">Trigger audit warnings when judge variance exceeds threshold.</p>
            </div>
            <select class="form-input-bare text-xs" style="width:auto;padding:6px 28px 6px 10px">
              <option value="15" selected>&gt;15% Deviation</option>
              <option value="10">&gt;10% Strict</option>
              <option value="20">&gt;20% Lenient</option>
            </select>
          </div>

          <div class="flex items-center justify-between p-3.5 rounded-xl" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07)">
            <div>
              <p class="text-xs font-bold" style="color:#e2e8f0">Auto-Calculate Ranks in Realtime</p>
              <p class="text-[11px] mt-0.5" style="color:#374151">Instantly update standings as judges submit scores.</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" checked class="sr-only peer">
              <div class="w-9 h-5 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600" style="background:#1e293b;border:1px solid rgba(255,255,255,0.15)"></div>
            </label>
          </div>

          <div class="flex items-center justify-between p-3.5 rounded-xl" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07)">
            <div>
              <p class="text-xs font-bold" style="color:#e2e8f0">Drop Highest &amp; Lowest Score (Olympic Rule)</p>
              <p class="text-[11px] mt-0.5" style="color:#374151">Discard extreme scores if 5+ judges are assigned.</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer">
              <div class="w-9 h-5 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600" style="background:#1e293b;border:1px solid rgba(255,255,255,0.15)"></div>
            </label>
          </div>

        </div>
      </div>

      <!-- Suggest Feature Card -->
      <div class="rounded-2xl overflow-hidden animate-fadeup-2" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
        <div class="px-6 py-4 flex items-center gap-3" style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(255,255,255,0.02)">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.3)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
          <div>
            <h2 class="text-sm font-extrabold" style="color:#e2e8f0">Suggest a New Feature</h2>
            <p class="text-[11px]" style="color:#374151">Propose enhancements directly to developers</p>
          </div>
        </div>
        <div class="px-6 py-5">
          <form action="/settings/suggest-feature" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="sm:col-span-2">
                <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Feature Title</label>
                <input type="text" name="title" placeholder="e.g. Live Audio Announcement for Winners" required class="form-input-bare w-full"/>
              </div>
              <div>
                <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Category</label>
                <select name="category" class="form-input-bare w-full">
                  <option value="Scoring UX">Scoring UX</option>
                  <option value="Printing">Printing &amp; PDF</option>
                  <option value="Connectivity">Connectivity &amp; Sync</option>
                  <option value="Security">Security &amp; Audit</option>
                  <option value="Display">Stage Display</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Detailed Description</label>
              <textarea name="description" rows="3" placeholder="Explain how this feature would benefit the system…" required class="form-input-bare resize-none w-full"></textarea>
            </div>
            <div class="flex justify-end">
              <button type="submit" class="btn-primary text-xs px-5 py-2.5"
                style="background:linear-gradient(135deg,#b45309,#d97706);box-shadow:0 4px 12px rgba(217,119,6,0.3)">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                Submit Suggestion
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Community Suggestions -->
      {{#if suggestions.length}}
      <div class="rounded-2xl overflow-hidden animate-fadeup-2" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
        <div class="px-6 py-4 flex items-center gap-3" style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(255,255,255,0.02)">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background:rgba(99,102,241,0.2);border:1px solid rgba(99,102,241,0.3)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h2 class="text-sm font-extrabold" style="color:#e2e8f0">Community Feature Requests</h2>
        </div>
        <div class="px-6 py-5 space-y-3">
          {{#each suggestions}}
          <div class="p-4 rounded-xl transition" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07)"
            onmouseover="this.style.borderColor='rgba(99,102,241,0.3)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.07)'">
            <div class="flex items-start justify-between gap-3 mb-1.5">
              <h3 class="text-xs font-bold" style="color:#e2e8f0">{{title}}</h3>
              <div class="flex items-center gap-1.5 flex-shrink-0">
                <span class="badge badge-blue text-[10px]">{{category}}</span>
                <span class="badge badge-gray text-[10px]">👍 {{votes}}</span>
              </div>
            </div>
            <p class="text-xs leading-relaxed" style="color:#64748b">{{description}}</p>
            {{#if submittedBy}}<p class="text-[11px] mt-1.5" style="color:#374151">By: <span class="font-bold" style="color:#94a3b8">{{submittedBy}}</span></p>{{/if}}
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

    </div>

    <!-- ── Right: System Info + Roadmap ── -->
    <div class="space-y-5">

      <!-- System Info -->
      <div class="rounded-2xl overflow-hidden animate-fadeup-1" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
        <div class="px-5 py-4 flex items-center gap-3" style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(255,255,255,0.02)">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background:rgba(139,92,246,0.2);border:1px solid rgba(139,92,246,0.3)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c4b5fd" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h2 class="text-sm font-extrabold" style="color:#e2e8f0">System Overview</h2>
        </div>
        <div class="px-5 py-4 space-y-3 text-xs">

          <div class="flex items-center justify-between py-2" style="border-bottom:1px solid rgba(255,255,255,0.05)">
            <span style="color:#64748b">Municipality</span>
            <span class="font-bold" style="color:#e2e8f0">{{municipality}}</span>
          </div>
          <div class="flex items-center justify-between py-2" style="border-bottom:1px solid rgba(255,255,255,0.05)">
            <span style="color:#64748b">System Version</span>
            <span class="font-bold" style="color:#e2e8f0">{{systemVersion}}</span>
          </div>
          <div class="flex items-center justify-between py-2" style="border-bottom:1px solid rgba(255,255,255,0.05)">
            <span style="color:#64748b">AI Audit Engine</span>
            <span class="badge badge-purple text-[10px]">{{aiModel}}</span>
          </div>
          <div class="flex items-center justify-between py-2" style="border-bottom:1px solid rgba(255,255,255,0.05)">
            <span style="color:#64748b">Database</span>
            <span class="inline-flex items-center gap-1.5 font-bold text-[11px]" style="color:#6ee7b7">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>Active
            </span>
          </div>
          <div class="flex items-center justify-between py-2">
            <span style="color:#64748b">Your Role</span>
            <span class="badge capitalize
              {{#if isAdmin}}badge-blue{{else}}{{#if isJudge}}badge-purple{{else}}{{#if isOrganizer}}badge-yellow{{else}}badge-green{{/if}}{{/if}}{{/if}}">
              {{userRole}}
            </span>
          </div>

          <div class="pt-2">
            <a href="/logout" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs transition"
              style="background:rgba(239,68,68,0.12);color:#fca5a5;border:1px solid rgba(239,68,68,0.2)">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Sign Out
            </a>
          </div>
        </div>
      </div>

      <!-- Planned Features / Roadmap -->
      <div class="rounded-2xl overflow-hidden animate-fadeup-2" style="background:linear-gradient(160deg,#0c1030,#0f1f5e,#080e22);border:1px solid rgba(99,102,241,0.2)">
        <div class="px-6 py-4 flex items-center justify-between" style="border-bottom:1px solid rgba(99,102,241,0.15)">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background:rgba(99,102,241,0.2);border:1px solid rgba(99,102,241,0.3)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <div>
              <h2 class="text-sm font-extrabold" style="color:#e2e8f0">Planned Features</h2>
              <p class="text-[11px]" style="color:#4b5563">Coming in future releases</p>
            </div>
          </div>
          <span class="badge badge-purple text-[10px]">Roadmap</span>
        </div>
        <div class="px-5 py-4 space-y-3">

          <!-- Feature 1: Offline Sync -->
          <div class="p-4 rounded-xl transition" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07)"
            onmouseover="this.style.borderColor='rgba(99,102,241,0.4)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.07)'">
            <div class="flex items-start justify-between gap-3 mb-1.5">
              <h3 class="text-xs font-bold flex items-center gap-2" style="color:#e2e8f0">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2.5"><path d="M1 6v16l7-4 8 4 7-4V2l-7 4-8-4-7 4z"/><path d="M8 2v16"/><path d="M16 6v16"/></svg>
                Offline Sync Mode for Remote Venues
              </h3>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold flex-shrink-0" style="background:rgba(59,130,246,0.15);color:#93c5fd;border:1px solid rgba(59,130,246,0.25)">Connectivity</span>
            </div>
            <p class="text-[11px] leading-relaxed" style="color:#64748b">Local IndexedDB caching so judges can submit scores even during wifi drops, syncing automatically when reconnected.</p>
          </div>

          <!-- Feature 2: Custom Printable Score Sheets -->
          <div class="p-4 rounded-xl transition" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07)"
            onmouseover="this.style.borderColor='rgba(99,102,241,0.4)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.07)'">
            <div class="flex items-start justify-between gap-3 mb-1.5">
              <h3 class="text-xs font-bold flex items-center gap-2" style="color:#e2e8f0">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                Custom Printable Score Sheets for Manual Audit
              </h3>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold flex-shrink-0" style="background:rgba(16,185,129,0.12);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25)">Printing</span>
            </div>
            <p class="text-[11px] leading-relaxed" style="color:#64748b">Generate pre-formatted PDF judge paper score sheets with contestant names and criteria barcodes.</p>
          </div>

          <!-- Feature 3: Judge Feedback & Comments -->
          <div class="p-4 rounded-xl transition" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07)"
            onmouseover="this.style.borderColor='rgba(99,102,241,0.4)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.07)'">
            <div class="flex items-start justify-between gap-3 mb-1.5">
              <h3 class="text-xs font-bold flex items-center gap-2" style="color:#e2e8f0">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Judge Feedback &amp; Comments Box per Score
              </h3>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold flex-shrink-0" style="background:rgba(139,92,246,0.12);color:#c4b5fd;border:1px solid rgba(139,92,246,0.25)">Scoring UX</span>
            </div>
            <p class="text-[11px] leading-relaxed" style="color:#64748b">Allow judges to add optional qualitative feedback notes alongside numerical percentage entries.</p>
          </div>

        </div>
      </div>
    </div>
  </div>

</main>
</div>
{{> footer }}
</body>
</html>
