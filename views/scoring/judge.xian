{{> head }}
<body class="min-h-screen flex flex-col" style="background:#060b18">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto pb-28" id="scoring-main">

  <!-- ── Sticky Header ── -->
  <div class="sticky top-0 z-20 px-4 sm:px-6 py-3 flex items-center justify-between gap-3 no-print"
    style="background:rgba(6,11,24,0.97);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.06);box-shadow:0 4px 32px rgba(0,0,0,0.5)">
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 shadow"
        style="background:linear-gradient(135deg,#4f46e5,#7c3aed)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      </div>
      <div class="min-w-0">
        <div class="font-extrabold text-sm truncate" style="color:#e2e8f0">Score Entry — {{event.name}}</div>
        <div class="text-xs truncate" style="color:#475569">
          Judge: <span class="font-semibold" style="color:#818cf8">{{userName}}</span>
          &bull; <span id="hdr-criteria-count">{{criteria.length}}</span> criteria
          &bull; <span id="hdr-contestant-pos">1</span>/{{contestants.length}} contestants
        </div>
      </div>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <!-- Completion ring -->
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs"
        style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)">
        <svg id="completion-ring" width="30" height="30" viewBox="0 0 30 30">
          <circle cx="15" cy="15" r="11" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="3"/>
          <circle id="ring-progress" cx="15" cy="15" r="11" fill="none" stroke="#6366f1" stroke-width="3"
            stroke-dasharray="69.12" stroke-dashoffset="69.12" stroke-linecap="round"
            transform="rotate(-90 15 15)" style="transition:stroke-dashoffset 0.5s ease,stroke 0.3s"/>
        </svg>
        <span id="overall-pct" class="font-extrabold" style="color:#e2e8f0">0%</span>
        <span style="color:#374151">done</span>
      </div>
      <a href="/events/{{event.id}}/results"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition"
        style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3)">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        <span class="hidden sm:inline">Live Results</span>
      </a>
    </div>
  </div>

  {{#if success_msg}}<div class="alert-success m-4 animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error m-4 animate-fadeup">{{error_msg}}</div>{{/if}}

  {{#if contestants.length}}

  <!-- ── Contestant Nav Dots ── -->
  <div class="px-4 sm:px-6 py-3 flex items-center gap-2 overflow-x-auto no-print"
    style="border-bottom:1px solid rgba(255,255,255,0.04)">
    <span class="text-[10px] font-extrabold uppercase tracking-widest flex-shrink-0" style="color:#374151">Jump:</span>
    {{#each contestants}}
    <button type="button"
      class="nav-dot flex-shrink-0 w-8 h-8 rounded-full text-[11px] font-extrabold transition-all border-2"
      data-idx="{{@index}}"
      style="background:rgba(255,255,255,0.05);color:#475569;border-color:rgba(255,255,255,0.08)"
      onclick="goToContestant({{@index}})">{{number}}</button>
    {{/each}}
  </div>

  <!-- ── Scoring Form ── -->
  <form id="scoringForm" method="POST" action="/events/{{event.id}}/scoring">
    {{#each contestants}}
    <div class="contestant-panel" data-idx="{{@index}}" data-contestant-id="{{id}}" data-total-criteria="{{scores.length}}"
      style="{{#unless @first}}display:none{{/unless}}">

      <div class="p-4 sm:p-6 grid lg:grid-cols-5 gap-5 xl:gap-7">

        <!-- ═══ LEFT: Contestant Card ═══ -->
        <div class="lg:col-span-2">
          <div class="rounded-3xl overflow-hidden sticky top-[68px]" style="background:#0d1526;border:1px solid rgba(255,255,255,0.08);box-shadow:0 20px 60px rgba(0,0,0,0.6)">

            <!-- Photo area -->
            <div class="relative overflow-hidden" style="aspect-ratio:3/4;background:linear-gradient(160deg,#0a1428,#0f1e3d)">
              {{#if photo}}
              <img src="{{photo}}" alt="{{name}}" class="absolute inset-0 w-full h-full object-cover" style="object-position:center top"/>
              {{else}}
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-28 h-28 rounded-full flex items-center justify-center text-white text-5xl font-black shadow-2xl"
                  style="background:linear-gradient(135deg,#1e3a8a,#4f46e5)">{{number}}</div>
              </div>
              {{/if}}

              <!-- Cinematic overlay -->
              <div class="absolute inset-0" style="background:linear-gradient(0deg,rgba(6,11,24,0.92) 0%,rgba(6,11,24,0.3) 40%,rgba(6,11,24,0.05) 70%,transparent 100%)"></div>
              <div class="absolute inset-0" style="background:linear-gradient(180deg,rgba(6,11,24,0.4) 0%,transparent 30%)"></div>

              <!-- Number badge top-left -->
              <div class="absolute top-4 left-4">
                <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-white font-black text-sm shadow-xl"
                  style="background:rgba(99,102,241,0.9);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.2)">{{number}}</div>
              </div>

              <!-- Score overlay top-right -->
              <div class="absolute top-4 right-4">
                <div class="px-3 py-2 rounded-2xl text-center" style="background:rgba(6,11,24,0.85);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.12)">
                  <div class="contestant-total text-xl font-black leading-none" style="color:#a5b4fc">0.00%</div>
                  <div class="text-[9px] font-bold uppercase tracking-widest mt-0.5" style="color:#374151">score</div>
                </div>
              </div>

              <!-- Name overlay bottom -->
              <div class="absolute bottom-0 left-0 right-0 px-5 py-5">
                <div class="text-white font-extrabold text-2xl leading-tight tracking-tight">{{name}}</div>
                <div class="text-sm mt-1 flex items-center gap-2 flex-wrap" style="color:rgba(255,255,255,0.6)">
                  {{#if barangay}}<span>Brgy. {{barangay}}</span>{{/if}}
                  {{#if age}}<span class="opacity-60">&bull;</span><span>{{age}} yrs</span>{{/if}}
                </div>
              </div>
            </div>

            <!-- Info section -->
            <div class="px-5 py-4 space-y-3">
              {{#if gender}}
              <div class="flex items-center justify-between text-sm">
                <span class="flex items-center gap-2" style="color:#475569">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M12 12v4M10 18h4"/></svg>Gender
                </span>
                <span class="font-semibold capitalize" style="color:#94a3b8">{{gender}}</span>
              </div>
              {{/if}}
              {{#if platform}}
              <div class="flex items-start justify-between gap-3 text-sm">
                <span class="flex items-center gap-2 flex-shrink-0" style="color:#475569">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 9.5-9.5z"/></svg>Platform
                </span>
                <span class="font-semibold text-right" style="color:#94a3b8">{{platform}}</span>
              </div>
              {{/if}}
              {{#if description}}
              <div class="rounded-xl p-3 text-xs leading-relaxed" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);color:#64748b">
                <span class="text-[10px] font-extrabold uppercase tracking-widest block mb-1.5" style="color:#374151">Bio</span>
                {{description}}
              </div>
              {{/if}}

              <!-- Fill progress -->
              <div class="pt-1" style="border-top:1px solid rgba(255,255,255,0.05)">
                <div class="flex justify-between text-[10px] mb-1.5" style="color:#374151">
                  <span class="font-extrabold uppercase tracking-wider">Criteria Filled</span>
                  <span class="contestant-fill-label font-extrabold" style="color:#e2e8f0">0 / {{scores.length}}</span>
                </div>
                <div class="h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)">
                  <div class="contestant-fill-bar h-full rounded-full transition-all duration-500" style="width:0%;background:linear-gradient(90deg,#4f46e5,#7c3aed)"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ═══ RIGHT: Scoring ═══ -->
        <div class="lg:col-span-3 space-y-4">

          <!-- Criteria header -->
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background:rgba(99,102,241,0.15);border:1px solid rgba(99,102,241,0.25)">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2.5"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <div>
              <div class="text-xs font-extrabold uppercase tracking-wider" style="color:#6366f1">Scoring Criteria</div>
              <div class="text-[11px]" style="color:#374151">{{scores.length}} criteria &bull; max 100% weighted total</div>
            </div>
          </div>

          <!-- Criteria cards -->
          {{#each scores}}
          <div class="score-box rounded-2xl overflow-hidden transition-all duration-300"
            data-criteria-idx="{{@index}}"
            style="background:#0d1526;border:1px solid rgba(255,255,255,0.07)">

            <!-- Card header -->
            <div class="px-5 py-3.5 flex items-center justify-between gap-3"
              style="border-bottom:1px solid rgba(255,255,255,0.05)">
              <div class="flex items-center gap-3 min-w-0">
                <!-- Color dot -->
                <div class="criteria-color-dot w-3 h-3 rounded-full flex-shrink-0" style="background:#6366f1"></div>
                <span class="font-extrabold text-sm truncate" style="color:#e2e8f0">{{criteriaName}}</span>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold" style="background:rgba(99,102,241,0.15);color:#a5b4fc;border:1px solid rgba(99,102,241,0.25)">{{weight}}%</span>
              </div>
            </div>

            <!-- Slider + Input -->
            <div class="px-5 py-4 space-y-4">

              <!-- Big score display -->
              <div class="flex items-center gap-4">
                <div class="flex-1">
                  <div class="relative">
                    <input type="number"
                      name="scores[{{../id}}][{{criteriaId}}]"
                      value="{{value}}"
                      min="0" max="{{maxScore}}" step="0.5"
                      placeholder="0"
                      data-weight="{{weight}}" data-max="{{maxScore}}"
                      class="score-input w-full text-center font-black focus:outline-none transition-all duration-200"
                      style="font-size:3rem;line-height:1;background:transparent;color:#6366f1;border:none;padding:0"
                      oninput="syncNumber(this)"/>
                    <div class="text-center text-xs font-bold mt-1" style="color:#374151">pts out of {{maxScore}}</div>
                  </div>
                </div>

                <!-- Donut progress ring (per criteria) -->
                <div class="relative flex-shrink-0" style="width:72px;height:72px">
                  <svg width="72" height="72" viewBox="0 0 72 72">
                    <circle cx="36" cy="36" r="28" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="6"/>
                    <circle class="criteria-ring" cx="36" cy="36" r="28" fill="none" stroke="#6366f1" stroke-width="6"
                      stroke-dasharray="175.9" stroke-dashoffset="175.9" stroke-linecap="round"
                      transform="rotate(-90 36 36)" style="transition:stroke-dashoffset 0.4s ease,stroke 0.3s"/>
                  </svg>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="criteria-pct text-xs font-extrabold" style="color:#e2e8f0">0%</span>
                  </div>
                </div>
              </div>

              <!-- Slider -->
              <div>
                <input type="range"
                  min="0" max="{{maxScore}}" step="0.5" value="{{value}}"
                  data-weight="{{weight}}" data-max="{{maxScore}}"
                  class="score-slider w-full cursor-pointer"
                  style="height:6px;accent-color:#6366f1"
                  oninput="syncSlider(this)"/>
                <div class="flex justify-between text-[10px] px-0.5 mt-1" style="color:#1e293b">
                  <span>0</span><span>{{maxScore}}</span>
                </div>
              </div>

              <!-- Metrics row -->
              <div class="grid grid-cols-2 gap-3">
                <div class="rounded-xl px-3 py-2.5" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06)">
                  <div class="text-[10px] font-bold uppercase tracking-wider mb-0.5" style="color:#374151">Score</div>
                  <div class="criteria-bar-wrap h-1.5 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)">
                    <div class="criteria-bar h-full rounded-full transition-all duration-300" style="width:0%;background:#6366f1"></div>
                  </div>
                </div>
                <div class="rounded-xl px-3 py-2.5" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06)">
                  <div class="text-[10px] font-bold uppercase tracking-wider mb-0.5" style="color:#374151">Contributes</div>
                  <div class="weighted-preview text-sm font-extrabold" style="color:#6ee7b7">0.00%</div>
                </div>
              </div>
            </div>
          </div>
          {{/each}}

          <!-- Save & Next button -->
          <button type="button"
            class="w-full py-4 rounded-2xl font-extrabold text-base text-white transition active:scale-[0.98] shadow-2xl save-contestant-btn"
            data-idx="{{@index}}"
            style="background:linear-gradient(135deg,#4f46e5,#7c3aed);box-shadow:0 8px 32px rgba(99,102,241,0.35)"
            onclick="saveAndNext({{@index}}, {{../contestants.length}})">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" style="display:inline;margin-right:8px;vertical-align:-2px"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            {{#if @last}}Save Scores &amp; Finish{{else}}Save &amp; Next Contestant{{/if}}
          </button>

        </div>
      </div>

      <!-- ── Navigation ── -->
      <div class="px-4 sm:px-6 pb-5 flex items-center justify-between gap-3 no-print">
        <button type="button" class="flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm transition"
          style="background:rgba(255,255,255,0.05);color:#64748b;border:1px solid rgba(255,255,255,0.08)"
          onclick="goToContestant({{sub1 @index}})"
          {{#if @first}}disabled style="opacity:0.25;cursor:not-allowed;background:transparent;border-color:rgba(255,255,255,0.04)"{{/if}}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          Previous
        </button>

        <div class="text-xs font-bold" style="color:#374151">
          <span style="color:#6366f1">{{add1 @index}}</span> / {{../contestants.length}}
        </div>

        <button type="button" class="flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm transition"
          style="background:rgba(99,102,241,0.12);color:#a5b4fc;border:1px solid rgba(99,102,241,0.25)"
          onclick="goToContestant({{add1 @index}})"
          {{#if @last}}disabled style="opacity:0.25;cursor:not-allowed"{{/if}}>
          Next
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>

    </div>
    {{/each}}
  </form>

  {{else}}
  <div class="p-12 text-center">
    <p class="font-semibold" style="color:#475569">No contestants found.</p>
    <a href="/events/{{event.id}}" class="text-indigo-400 hover:underline text-sm mt-2 inline-block">Back to event</a>
  </div>
  {{/if}}

</main>
</div>

<style>
/* Slider track */
input[type=range].score-slider { -webkit-appearance:none; width:100%; border-radius:999px; outline:none; }
input[type=range].score-slider::-webkit-slider-runnable-track { height:6px; border-radius:999px; background:rgba(255,255,255,0.08); }
input[type=range].score-slider::-webkit-slider-thumb {
  -webkit-appearance:none; width:22px; height:22px; border-radius:50%;
  background:#6366f1; border:3px solid #0d1526;
  box-shadow:0 0 0 2px rgba(99,102,241,0.5),0 4px 12px rgba(99,102,241,0.4);
  cursor:pointer; transition:transform 0.15s,box-shadow 0.15s;
}
input[type=range].score-slider::-webkit-slider-thumb:hover {
  transform:scale(1.2);
  box-shadow:0 0 0 3px rgba(99,102,241,0.6),0 6px 20px rgba(99,102,241,0.5);
}
input[type=range].score-slider:focus { outline:none; }
.score-box.filled { border-color:rgba(99,102,241,0.35) !important; }
.score-box.filled .criteria-color-dot { box-shadow:0 0 8px currentColor; }
.nav-dot.scored { background:rgba(16,185,129,0.25) !important; color:#6ee7b7 !important; border-color:rgba(16,185,129,0.5) !important; }
.nav-dot.active { background:rgba(99,102,241,0.25) !important; color:#a5b4fc !important; border-color:rgba(99,102,241,0.6) !important; }
/* Score input — hide spinners */
.score-input::-webkit-inner-spin-button, .score-input::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
.score-input[type=number] { -moz-appearance:textfield; }
</style>

<script>
(function() {
  const COLORS = ["#6366f1","#7c3aed","#059669","#dc2626","#d97706","#0891b2","#be185d","#65a30d","#f59e0b","#06b6d4"];
  const CIRC72 = 2 * Math.PI * 28; // for 72px donut r=28 → 175.93
  const CIRC11 = 2 * Math.PI * 11; // for header ring r=11 → 69.12
  const storeKey = "scoresync_draft_{{event.id}}";
  let saveTimer, currentIdx = 0;
  const totalContestants = {{contestants.length}};

  /* ── Navigate ── */
  window.goToContestant = function(idx) {
    idx = parseInt(idx);
    if (isNaN(idx) || idx < 0 || idx >= totalContestants) return;
    document.querySelectorAll('.contestant-panel').forEach((p, i) => p.style.display = i === idx ? '' : 'none');
    document.querySelectorAll('.nav-dot').forEach((d, i) => {
      d.classList.toggle('active', i === idx);
    });
    currentIdx = idx;
    document.getElementById('hdr-contestant-pos').textContent = idx + 1;
    window.scrollTo({ top: 0, behavior: 'smooth' });
    updateOverallRing();
  };

  /* ── Save & Next ── */
  window.saveAndNext = function(idx, total) {
    const panel = document.querySelector('.contestant-panel[data-idx="' + idx + '"]');
    if (!panel) return;
    const inputs = panel.querySelectorAll('.score-input');
    const empty = [...inputs].filter(n => n.value === '' || parseFloat(n.value) < 0);
    if (empty.length && !confirm(empty.length + ' score(s) are empty. Submit anyway?')) return;
    document.getElementById('scoringForm').submit();
  };

  /* ── Sync ── */
  window.syncSlider = function(el) {
    const box = el.closest('.score-box');
    const num = box.querySelector('.score-input');
    num.value = el.value;
    updateBox(box); schedSave();
  };
  window.syncNumber = function(el) {
    const box = el.closest('.score-box');
    const sl  = box.querySelector('.score-slider');
    const max = parseFloat(el.dataset.max) || 100;
    let v = parseFloat(el.value); if (isNaN(v)) v = 0;
    v = Math.min(Math.max(0, v), max);
    sl.value = v; updateBox(box); schedSave();
  };

  /* ── Update single box ── */
  function updateBox(box) {
    const num    = box.querySelector('.score-input');
    const val    = parseFloat(num.value) || 0;
    const max    = parseFloat(num.dataset.max) || 100;
    const weight = parseFloat(num.dataset.weight) || 0;
    const pct    = max > 0 ? (val / max) * 100 : 0;
    const contrib= (val / max) * weight;
    const idx    = parseInt(box.dataset.criteriaIdx) || 0;
    const color  = COLORS[idx % COLORS.length];

    // Update color dot + slider accent
    const dot = box.querySelector('.criteria-color-dot');
    if (dot) dot.style.background = color;
    const sl = box.querySelector('.score-slider');
    if (sl) { sl.style.accentColor = color; sl.style.setProperty('--thumb-color', color); }

    // Donut ring (r=28, circ≈175.93)
    const ring = box.querySelector('.criteria-ring');
    if (ring) {
      ring.style.stroke = color;
      ring.style.strokeDashoffset = (CIRC72 - (pct / 100) * CIRC72).toFixed(2);
    }
    const pctEl = box.querySelector('.criteria-pct');
    if (pctEl) { pctEl.textContent = Math.round(pct) + '%'; pctEl.style.color = color; }

    const bar = box.querySelector('.criteria-bar');
    if (bar) { bar.style.width = pct.toFixed(1) + '%'; bar.style.background = color; }

    const wp = box.querySelector('.weighted-preview');
    if (wp) wp.textContent = contrib.toFixed(2) + '%';

    if (val > 0) box.classList.add('filled'); else box.classList.remove('filled');

    updateContestantPanel(box.closest('.contestant-panel'));
    updateOverallRing();
  }

  /* ── Panel totals ── */
  function updateContestantPanel(panel) {
    if (!panel) return;
    const boxes  = panel.querySelectorAll('.score-box');
    let total = 0, filled = 0;
    boxes.forEach(b => {
      const n = b.querySelector('.score-input');
      const v = parseFloat(n.value) || 0;
      const m = parseFloat(n.dataset.max) || 100;
      const w = parseFloat(n.dataset.weight) || 0;
      if (parseFloat(n.value) > 0) filled++;
      total += (v / m) * w;
    });
    const totEl = panel.querySelector('.contestant-total');
    if (totEl) totEl.textContent = total.toFixed(2) + '%';

    const pct = boxes.length > 0 ? (filled / boxes.length) * 100 : 0;
    const bar = panel.querySelector('.contestant-fill-bar');
    if (bar) {
      bar.style.width = pct.toFixed(0) + '%';
      bar.style.background = filled === boxes.length
        ? 'linear-gradient(90deg,#10b981,#34d399)'
        : 'linear-gradient(90deg,#4f46e5,#7c3aed)';
    }
    const lbl = panel.querySelector('.contestant-fill-label');
    if (lbl) lbl.textContent = filled + ' / ' + boxes.length;

    const idx = panel.dataset.idx;
    const dot = document.querySelector('.nav-dot[data-idx="' + idx + '"]');
    if (dot && filled === boxes.length && boxes.length > 0) dot.classList.add('scored');
  }

  /* ── Overall ring ── */
  function updateOverallRing() {
    const all    = document.querySelectorAll('.score-input');
    const filled = [...all].filter(i => parseFloat(i.value) > 0).length;
    const pct    = all.length > 0 ? (filled / all.length) * 100 : 0;
    const offset = CIRC11 - (pct / 100) * CIRC11;
    const ring   = document.getElementById('ring-progress');
    if (ring) {
      ring.style.strokeDashoffset = offset.toFixed(2);
      ring.style.stroke = pct >= 100 ? '#10b981' : '#6366f1';
    }
    const el = document.getElementById('overall-pct');
    if (el) el.textContent = Math.round(pct) + '%';
  }

  /* ── Draft ── */
  function schedSave() { clearTimeout(saveTimer); saveTimer = setTimeout(saveDraft, 800); }
  function saveDraft() {
    const data = {};
    document.querySelectorAll('.contestant-panel').forEach(p => {
      const cid = p.dataset.contestantId; data[cid] = {};
      p.querySelectorAll('.score-input').forEach(n => {
        const m = n.name.match(/scores\[([^\]]+)\]\[([^\]]+)\]/);
        if (m) data[cid][m[2]] = n.value;
      });
    });
    try { localStorage.setItem(storeKey, JSON.stringify(data)); } catch(e){}
  }
  function restoreDraft() {
    try {
      const data = JSON.parse(localStorage.getItem(storeKey) || '{}');
      document.querySelectorAll('.contestant-panel').forEach(p => {
        const cid = p.dataset.contestantId; if (!data[cid]) return;
        p.querySelectorAll('.score-input').forEach(n => {
          const m = n.name.match(/scores\[([^\]]+)\]\[([^\]]+)\]/);
          if (m && data[cid][m[2]] !== undefined && n.value === '') {
            n.value = data[cid][m[2]];
            const sl = n.closest('.score-box')?.querySelector('.score-slider');
            if (sl) sl.value = n.value;
          }
        });
      });
    } catch(e){}
  }

  /* ── Init ── */
  restoreDraft();
  document.querySelectorAll('.score-box').forEach(b => updateBox(b));
  goToContestant(0);
})();
</script>

{{> footer }}
</body>
</html>
