<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{title}}</title>
  <link rel="stylesheet" href="/tailwind.css"/>
  <style>
    body { background:#0a0f1e; color:#e2e8f0; font-family:system-ui,sans-serif; }
    .print-btn { position:fixed; top:16px; right:16px; z-index:100; }
    @media print {
      .no-print { display:none !important; }
      body { background:#fff !important; color:#111 !important; }
      .print-card { background:#fff !important; border:1px solid #e5e7eb !important; color:#111 !important; }
      .print-card td, .print-card th { color:#111 !important; border-color:#e5e7eb !important; }
      h1, h2, h3, p, span, div { color:#111 !important; }
      .rank-badge { background:#e5e7eb !important; color:#111 !important; }
      .sig-box { border:1px solid #9ca3af !important; background:#f9fafb !important; }
      .sig-line { border-bottom:1px solid #111 !important; }
      .page-break-before { page-break-before: always; }
    }
    .sig-box { border:1px solid rgba(99,102,241,0.3); background:rgba(99,102,241,0.04); border-radius:12px; padding:16px; }
    .sig-line { border-bottom:1px dashed rgba(99,102,241,0.4); height:36px; margin:8px 0 4px; }
  </style>
</head>
<body>

<!-- Print / Back buttons -->
<div class="no-print print-btn flex gap-2">
  <a href="/events/{{event.id}}/results" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold" style="background:rgba(255,255,255,0.08);color:#94a3b8;border:1px solid rgba(255,255,255,0.1)">← Back</a>
  <button onclick="window.print()" class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-xl text-xs font-bold text-white" style="background:linear-gradient(135deg,#2563eb,#7c3aed)">🖨 Print / Save PDF</button>
</div>

<div class="max-w-4xl mx-auto px-6 py-10 space-y-8">

  <!-- ── Event Header ── -->
  <div class="print-card rounded-2xl p-6 text-center" style="background:#111827;border:1px solid rgba(255,255,255,0.1)">
    <div class="text-xs font-bold uppercase tracking-widest mb-1" style="color:#6366f1">Official Competition Report</div>
    <h1 class="text-2xl font-black mb-3" style="color:#e2e8f0">{{event.name}}</h1>
    <div class="flex flex-wrap justify-center gap-4 text-sm" style="color:#94a3b8">
      {{#if event.date}}<span>📅 {{event.date}}{{#if event.time}} at {{event.time}}{{/if}}</span>{{/if}}
      {{#if event.venue}}<span>📍 {{event.venue}}</span>{{/if}}
      {{#if event.type}}<span class="capitalize">🏷 {{#if (eq event.type "other")}}{{#if event.otherType}}{{event.otherType}}{{else}}Other{{/if}}{{else}}{{event.type}}{{/if}}</span>{{/if}}
      {{#if event.organizer}}<span>🏢 {{event.organizer}}</span>{{/if}}
    </div>
    <div class="mt-3 text-xs" style="color:#64748b">Generated: {{generatedAt}} &bull; {{judgeCount}} judge(s) &bull; {{ranked.length}} contestant(s)</div>
  </div>

  <!-- ── Criteria Table ── -->
  {{#if criteria.length}}
  <div class="print-card rounded-2xl overflow-hidden" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
    <div class="px-5 py-3 font-extrabold text-sm" style="color:#e2e8f0;border-bottom:1px solid rgba(255,255,255,0.07)">Scoring Criteria</div>
    <table class="w-full text-sm">
      <thead><tr style="background:rgba(255,255,255,0.03)">
        <th class="px-4 py-2.5 text-left text-xs font-bold uppercase tracking-wider" style="color:#64748b">#</th>
        <th class="px-4 py-2.5 text-left text-xs font-bold uppercase tracking-wider" style="color:#64748b">Criteria Name</th>
        <th class="px-4 py-2.5 text-right text-xs font-bold uppercase tracking-wider" style="color:#64748b">Weight %</th>
        <th class="px-4 py-2.5 text-right text-xs font-bold uppercase tracking-wider" style="color:#64748b">Max Score</th>
      </tr></thead>
      <tbody>
        {{#each criteria}}
        <tr style="border-top:1px solid rgba(255,255,255,0.04)">
          <td class="px-4 py-2.5 text-sm" style="color:#64748b">{{add1 @index}}</td>
          <td class="px-4 py-2.5 font-semibold" style="color:#e2e8f0">{{name}}</td>
          <td class="px-4 py-2.5 text-right font-bold" style="color:#a5b4fc">{{weight}}%</td>
          <td class="px-4 py-2.5 text-right" style="color:#64748b">{{maxScore}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <!-- ── Official Ranked Results ── -->
  {{#if ranked.length}}
  <div class="print-card rounded-2xl overflow-hidden" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
    <div class="px-5 py-3 font-extrabold text-sm" style="color:#e2e8f0;border-bottom:1px solid rgba(255,255,255,0.07)">Official Ranked Results</div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr style="background:rgba(255,255,255,0.03)">
          <th class="px-3 py-2.5 text-center text-xs font-bold uppercase tracking-wider" style="color:#64748b">Rank</th>
          <th class="px-3 py-2.5 text-center text-xs font-bold uppercase tracking-wider" style="color:#64748b">No.</th>
          <th class="px-3 py-2.5 text-left text-xs font-bold uppercase tracking-wider" style="color:#64748b">Name</th>
          <th class="px-3 py-2.5 text-left text-xs font-bold uppercase tracking-wider" style="color:#64748b">Barangay</th>
          {{#each criteria}}<th class="px-3 py-2.5 text-right text-xs font-bold uppercase tracking-wider" style="color:#64748b">{{name}}</th>{{/each}}
          <th class="px-3 py-2.5 text-right text-xs font-bold uppercase tracking-wider" style="color:#64748b">Final Score</th>
          <th class="px-3 py-2.5 text-right text-xs font-bold uppercase tracking-wider" style="color:#64748b">Gap to 1st</th>
        </tr></thead>
        <tbody>
          {{#each ranked}}
          <tr style="border-top:1px solid rgba(255,255,255,0.04)">
            <td class="px-3 py-2.5 text-center">
              <span class="rank-badge inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-black"
                style="{{#if (eq rank 1)}}background:linear-gradient(135deg,#b45309,#f59e0b);color:#fff{{else}}{{#if (eq rank 2)}}background:linear-gradient(135deg,#6b7280,#9ca3af);color:#fff{{else}}{{#if (eq rank 3)}}background:linear-gradient(135deg,#78350f,#d97706);color:#fff{{else}}background:rgba(255,255,255,0.08);color:#64748b{{/if}}{{/if}}{{/if}}">
                {{rank}}
              </span>
            </td>
            <td class="px-3 py-2.5 text-center text-sm font-bold" style="color:#64748b">{{number}}</td>
            <td class="px-3 py-2.5 font-bold" style="color:#e2e8f0">{{name}}</td>
            <td class="px-3 py-2.5 text-sm" style="color:#94a3b8">{{barangay}}</td>
            {{#each breakdown}}<td class="px-3 py-2.5 text-right text-sm" style="color:#a5b4fc">{{avg}}</td>{{/each}}
            <td class="px-3 py-2.5 text-right font-black" style="color:#6ee7b7">{{finalScoreDisplay}}%</td>
            <td class="px-3 py-2.5 text-right text-sm" style="color:#64748b">{{#if (eq rank 1)}}—{{else}}-{{gapToFirst}}{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  {{/if}}

  <!-- ── Judge Breakdown (per-judge score sheet) ── -->
  {{#each judgeBreakdown}}
  <div class="print-card page-break-before rounded-2xl overflow-hidden" style="background:#111827;border:1px solid rgba(255,255,255,0.08)">
    <div class="px-5 py-3 flex items-center justify-between" style="border-bottom:1px solid rgba(255,255,255,0.07)">
      <div>
        <div class="font-extrabold text-sm" style="color:#e2e8f0">{{alias}} Score Sheet</div>
        <div class="text-xs mt-0.5" style="color:#64748b">{{judgeName}} &bull; {{scoredCount}}/{{totalContestants}} scored ({{completionPct}}%)</div>
      </div>
      {{#if signed}}<span class="text-xs font-bold px-2.5 py-1 rounded-full" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3)">✓ Signed</span>{{/if}}
    </div>
    {{#if contestantScores.length}}
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr style="background:rgba(255,255,255,0.03)">
          <th class="px-3 py-2 text-center text-xs font-bold uppercase tracking-wider" style="color:#64748b">No.</th>
          <th class="px-3 py-2 text-left text-xs font-bold uppercase tracking-wider" style="color:#64748b">Name</th>
          {{#each ../criteria}}<th class="px-3 py-2 text-right text-xs font-bold uppercase tracking-wider" style="color:#64748b">{{name}}</th>{{/each}}
          <th class="px-3 py-2 text-right text-xs font-bold uppercase tracking-wider" style="color:#64748b">Weighted Total</th>
        </tr></thead>
        <tbody>
          {{#each contestantScores}}
          <tr style="border-top:1px solid rgba(255,255,255,0.04)">
            <td class="px-3 py-2 text-center text-xs" style="color:#64748b">{{number}}</td>
            <td class="px-3 py-2 font-semibold" style="color:#e2e8f0">{{name}}</td>
            {{#each scores}}
            <td class="px-3 py-2 text-right" style="color:{{#if value}}#a5b4fc{{else}}#374151{{/if}}">{{#if value}}{{value}}{{else}}—{{/if}}</td>
            {{/each}}
            <td class="px-3 py-2 text-right font-bold" style="color:#6ee7b7">{{total}}%</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{/if}}
  </div>
  {{/each}}

  <!-- ── Digital Signature Block ── -->
  {{#if judgeBreakdown.length}}
  <div class="print-card rounded-2xl p-6" style="background:#111827;border:1px solid rgba(99,102,241,0.2)">
    <div class="font-extrabold text-sm mb-4" style="color:#e2e8f0">Judge Certification &amp; Digital Signatures</div>
    <p class="text-xs mb-5" style="color:#94a3b8">Each judge certifies that the above scores are accurate and reflect their honest evaluation of each contestant.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {{#each judgeBreakdown}}
      <div class="sig-box">
        <div class="flex items-center justify-between mb-2">
          <div>
            <div class="font-bold text-sm" style="color:#e2e8f0">{{alias}}</div>
            <div class="text-xs" style="color:#94a3b8">{{judgeName}}</div>
          </div>
          {{#if signed}}
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3)">✓ Signed</span>
          {{else}}
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:rgba(239,68,68,0.1);color:#fca5a5;border:1px solid rgba(239,68,68,0.2)">Pending</span>
          {{/if}}
        </div>
        <div class="text-[10px] mb-1" style="color:#64748b">Scored {{scoredCount}} of {{totalContestants}} contestants ({{completionPct}}%)</div>
        <p class="text-[10px] italic mb-2" style="color:#64748b">"I certify that the above scores are accurate and reflect my honest evaluation."</p>
        <div class="sig-line"></div>
        <div class="text-[10px] mt-1" style="color:#475569">
          {{#if signed}}
          Digitally confirmed{{#if signedAt}} — {{signedAt}}{{/if}}
          {{else}}
          Signature / Digital Confirmation
          {{/if}}
        </div>
        {{#unless signed}}
        {{#if isSelf}}
        <form method="POST" action="/events/{{../event.id}}/report/sign" class="mt-3 no-print">
          <input type="hidden" name="_csrf" value="{{../csrfToken}}">
          <button type="submit" class="w-full py-2 rounded-xl text-xs font-bold text-white transition"
            style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
            ✍ Confirm &amp; Sign
          </button>
        </form>
        {{/if}}
        {{/unless}}
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  <div class="text-center text-xs pb-6" style="color:#374151">ScoreSync — Official Report &bull; {{generatedAt}}</div>

</div>

{{#if success_msg}}<div style="position:fixed;bottom:20px;right:20px;background:#065f46;color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:12px;padding:12px 18px;font-size:12px;font-weight:700;z-index:200">{{success_msg}}</div>{{/if}}
{{#if error_msg}}<div style="position:fixed;bottom:20px;right:20px;background:#7f1d1d;color:#fca5a5;border:1px solid rgba(239,68,68,0.3);border-radius:12px;padding:12px 18px;font-size:12px;font-weight:700;z-index:200">{{error_msg}}</div>{{/if}}

</body>
</html>
