<div id="sidebar-overlay" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden transition-opacity"></div>

<nav class="h-14 border-b flex items-center px-3 sm:px-5 gap-2.5 sticky top-0 z-30"
  style="background:#0d1424;border-bottom-color:rgba(255,255,255,0.06);box-shadow:0 1px 0 rgba(255,255,255,0.04),0 4px 24px rgba(0,0,0,0.4)">

  <!-- Mobile Hamburger Toggle -->
  <button type="button" onclick="toggleMobileSidebar()" class="md:hidden p-2 text-slate-300 hover:text-white focus:outline-none rounded-xl hover:bg-white/10 transition flex-shrink-0" aria-label="Toggle Navigation Menu">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <!-- Brand -->
  <a href="/dashboard" class="flex items-center gap-2 flex-shrink-0">
    <img src="/scoresync-logo.png" alt="ScoreSync" class="w-8 h-8 object-contain rounded-full" style="background:#fff;border:1.5px solid rgba(255,255,255,0.15)"/>
    <span class="font-black text-white text-sm tracking-tight hidden sm:block">ScoreSync</span>
  </a>

  <!-- Breadcrumb -->
  <div class="hidden lg:flex items-center gap-1.5 text-sm text-slate-500 flex-shrink-0 ml-1">
    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="text-slate-400">{{ title }}</span>
  </div>

  <!-- Right Actions -->
  <div class="flex items-center gap-2 sm:gap-2.5 ml-auto flex-shrink-0">

    <!-- Role badge -->
    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-extrabold"
      style="{{#if isAdmin}}background:rgba(37,99,235,0.15);color:#93c5fd;border:1px solid rgba(37,99,235,0.3){{else}}{{#if isJudge}}background:rgba(139,92,246,0.15);color:#c4b5fd;border:1px solid rgba(139,92,246,0.3){{else}}{{#if isOrganizer}}background:rgba(245,158,11,0.15);color:#fcd34d;border:1px solid rgba(245,158,11,0.3){{else}}background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3){{/if}}{{/if}}{{/if}}">
      {{#if isAdmin}}
      <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3 6 6.5 1-4.8 4.5 1.2 6.5L12 16l-5.9 3 1.2-6.5L2.5 8 9 7z"/></svg>
      {{else}}{{#if isJudge}}
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      {{else}}
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/></svg>
      {{/if}}{{/if}}
      <span class="capitalize">{{#if isEncoder}}Participant{{else}}{{userRole}}{{/if}}</span>
    </span>

    <!-- Profile Pill -->
    <a href="/settings" class="flex items-center gap-2 pl-1 pr-3 py-1 rounded-full border transition group"
      style="background:rgba(255,255,255,0.07);border-color:rgba(255,255,255,0.12)">
      <div class="w-7 h-7 rounded-full overflow-hidden flex-shrink-0 shadow" style="border:1.5px solid rgba(255,255,255,0.2)">
        {{#if userAvatar}}
        <img src="{{userAvatar}}" alt="{{userName}}" class="navbar-avatar-img w-full h-full object-cover"/>
        {{else}}
        <div class="w-full h-full grad-brand flex items-center justify-center text-white text-xs font-black">{{ userInitial }}</div>
        {{/if}}
      </div>
      <span class="text-xs font-bold text-slate-300 max-w-[160px] sm:max-w-[200px] truncate group-hover:text-white transition">{{ userName }}</span>
    </a>

  </div>
</nav>



