{{> head }}
<body class="min-h-screen" style="background:#0a0f1e">
{{> navbar }}

<main class="max-w-5xl mx-auto p-4 sm:p-6 space-y-6">

  <!-- ── Flash Banners ── -->
  {{#if success_msg}}
  <div class="alert-success animate-fadeup" role="alert">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    {{success_msg}}
  </div>
  {{/if}}
  {{#if error_msg}}
  <div class="alert-error animate-fadeup" role="alert">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    {{error_msg}}
  </div>
  {{/if}}

  <!-- ── Already-voted banner (shown by JS if localStorage hit) ── -->
  <div id="voted-banner" class="alert-success animate-fadeup" style="display:none" role="status">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    ✓ You already voted! Thank you for participating.
  </div>

  <!-- ── Hero Header ── -->
  <div class="card-flat overflow-hidden animate-fadeup" style="background:linear-gradient(135deg,#0f2156,#1a56db);border-color:rgba(255,255,255,0.12)">
    <div class="p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center gap-4">
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-1">
          {{#if votingOpen}}
          <span class="badge badge-green">
            <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
            Voting Open
          </span>
          {{else}}
          <span class="badge badge-gray">Voting Closed</span>
          {{/if}}
          {{#unless votingOpen}}<span class="badge badge-blue">{{totalVotes}} votes cast</span>{{/unless}}
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight leading-tight">{{event.name}}</h1>
        <p class="mt-1 text-sm font-semibold" style="color:rgba(255,255,255,0.7)">
          People's Choice Award
        </p>
      </div>
      <div class="flex-shrink-0">
        <svg width="52" height="52" viewBox="0 0 24 24" fill="rgba(244,63,94,0.8)" stroke="none">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- ── Voting Closed Banner ── -->
  {{#unless votingOpen}}
  <div class="alert-error animate-fadeup-1" role="status">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    Voting is currently closed. Check back later.
  </div>
  {{/unless}}

  <!-- ── Contestant Grid ── -->
  {{#if contestants}}
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 animate-fadeup-1">
    {{#each contestants}}
    <div class="card-flat overflow-hidden flex flex-col" data-contestant-id="{{id}}" style="border-radius:16px">

      <!-- Photo / Placeholder -->
      <div class="relative" style="aspect-ratio:3/4;background:rgba(0,0,0,0.3)">
        {{#if photo}}
        <img src="{{photo}}" alt="{{name}}" class="w-full h-full object-cover" loading="lazy">
        {{else}}
        <div class="w-full h-full flex items-center justify-center" style="background:linear-gradient(135deg,#0f2156,#1a56db)">
          <span class="text-4xl font-black text-white" style="opacity:0.5">{{number}}</span>
        </div>
        {{/if}}

        <!-- Number badge -->
        <div class="absolute top-2 left-2 w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-extrabold shadow" style="background:#2563eb;border:1.5px solid rgba(255,255,255,0.3)">
          {{number}}
        </div>
      </div>

      <!-- Info -->
      <div class="p-3 flex flex-col gap-2 flex-1">
        <div>
          <div class="font-bold text-sm truncate" style="color:#e2e8f0">{{name}}</div>
          {{#if barangay}}
          <div class="text-xs truncate mt-0.5" style="color:#64748b">{{barangay}}</div>
          {{/if}}
        </div>

        <!-- Audience tallies are withheld until voting closes -->
        <div class="vote-result" style="display:{{#if ../audienceResultsAvailable}}block{{else}}none{{/if}}">
          <div style="height:4px;background:rgba(255,255,255,0.08);border-radius:999px;overflow:hidden">
            <div id="bar-{{id}}"
                 style="height:100%;background:#e11d48;border-radius:999px;width:{{voteBarPct}}%;transition:width 0.6s ease">
            </div>
          </div>
          <span id="count-{{id}}" class="text-xs font-semibold" style="color:#94a3b8">
            {{voteCount}} vote{{#unless (eq voteCount 1)}}s{{/unless}}
          </span>
        </div>

        <!-- Vote button -->
        <form method="POST" action="/events/{{../event.id}}/vote" style="margin-top:auto">
          <input type="hidden" name="_csrf" value="{{../csrfToken}}">
          <input type="hidden" name="contestantId" value="{{id}}">
          <button type="submit"
                  class="vote-btn btn-primary w-full text-sm"
                  data-id="{{id}}"
                  style="border-radius:10px;padding:8px 0;width:100%"
                  {{#unless ../votingOpen}}disabled{{/unless}}>
            Vote ♥
          </button>
        </form>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <div class="card-flat p-8 text-center animate-fadeup-1">
    <p style="color:#64748b">No contestants registered yet.</p>
  </div>
  {{/if}}

  <!-- ── QR Code Section ── -->
  <div class="card-flat p-5 animate-fadeup-2 flex flex-col sm:flex-row sm:items-center gap-4">
    <div class="flex-1 min-w-0">
      <div class="font-bold text-sm" style="color:#e2e8f0">Share this voting page</div>
      <div class="text-xs mt-1 break-all" style="color:#64748b" id="vote-url"></div>
    </div>
    <p id="vote-refresh-status" class="text-xs" role="status" aria-live="polite"></p>
    <button type="button"
            onclick="showQR()"
            class="btn-secondary flex-shrink-0"
            style="padding:8px 18px;font-size:0.8rem"
            aria-label="Show QR Code">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
        <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/>
      </svg>
      Show QR Code
    </button>
  </div>

  <!-- ── Client script ── -->
  <script>
  (function () {
    // Show current URL under QR section
    var voteUrl = window.location.origin + window.location.pathname;
    var urlEl = document.getElementById('vote-url');
    if (urlEl) urlEl.textContent = voteUrl;

    var STORAGE_KEY = 'ss_voted_' + '{{event.id}}';

    // If already voted, disable buttons + show banner
    var alreadyVoted = false;
    try {
      alreadyVoted = localStorage.getItem(STORAGE_KEY) === '1';
    } catch (error) {
      console.warn('Unable to read the local voting hint.', error);
    }
    if (alreadyVoted) {
      document.getElementById('voted-banner').style.display = '';
      document.querySelectorAll('.vote-btn').forEach(function (b) {
        b.disabled = true;
        b.textContent = '✓ Voted';
      });
    }

    // After success flash, mark voted in localStorage
    var successEl = document.querySelector('.alert-success:not(#voted-banner)');
    if (successEl && successEl.textContent.indexOf('vote has been cast') !== -1) {
      try {
        localStorage.setItem(STORAGE_KEY, '1');
      } catch (error) {
        console.warn('Unable to save the local voting hint.', error);
      }
      document.querySelectorAll('.vote-btn').forEach(function (b) {
        b.disabled = true;
        b.textContent = '✓ Voted';
      });
    }

    // Results remain hidden until the server confirms voting has closed.
    var EVENT_ID = '{{event.id}}';
    function refreshCounts() {
      fetch('/events/' + EVENT_ID + '/vote/counts')
        .then(function (r) {
          if (!r.ok) throw new Error('Vote-results request failed: ' + r.status);
          return r.json();
        })
        .then(function (data) {
          if (!data.resultsAvailable) return;
          var votes = data.votes || {};
          var vals   = Object.values(votes).map(Number);
          var maxVal = vals.length ? Math.max.apply(null, vals) : 1;
          if (maxVal < 1) maxVal = 1;
          document.querySelectorAll('[data-contestant-id]').forEach(function (card) {
            var cid = card.dataset.contestantId;
            var count = Number(votes[cid] || 0);
            var countEl = document.getElementById('count-' + cid);
            var barEl   = document.getElementById('bar-'   + cid);
            if (countEl) countEl.textContent = count + (count === 1 ? ' vote' : ' votes');
            if (barEl) barEl.style.width = Math.round((count / maxVal) * 100) + '%';
            var result = card.querySelector('.vote-result');
            if (result) result.style.display = '';
          });
          var status = document.getElementById('vote-refresh-status');
          if (status) status.textContent = 'Final audience results are available.';
        })
        .catch(function (error) {
          console.error('Unable to refresh audience vote results.', error);
          var status = document.getElementById('vote-refresh-status');
          if (status) status.textContent = 'Vote results could not be refreshed. Retrying soon.';
        });
    }

    var refreshTimer;
    function startRefreshing() {
      if (refreshTimer) return;
      refreshCounts();
      refreshTimer = setInterval(refreshCounts, 10000);
    }
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        clearInterval(refreshTimer);
        refreshTimer = null;
      } else {
        startRefreshing();
      }
    });
    startRefreshing();
  })();

  // ── QR overlay ──
  var qrState = 'idle';
  function showQR() {
    var overlay = document.getElementById('qr-overlay');
    var errorEl = document.getElementById('qr-error');
    overlay.style.display = 'flex';
    errorEl.textContent = '';
    if (qrState === 'loading') return;
    function renderQR() {
      qrState = 'loading';
      try {
        var container = document.getElementById('qr-container');
        container.textContent = '';
        new window.QRCode(container, {
          text: window.location.origin + window.location.pathname,
          width: 280,
          height: 280,
          colorDark: '#1e3a8a',
          colorLight: '#ffffff',
          correctLevel: window.QRCode.CorrectLevel.H
        });
        qrState = 'loaded';
      } catch (error) {
        qrState = 'idle';
        errorEl.textContent = 'QR code could not be generated. Try again.';
        console.error('QR generation failed.', error);
      }
    }
    if (window.QRCode) {
      renderQR();
    } else {
      qrState = 'loading';
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js';
      s.crossOrigin = 'anonymous';
      s.integrity = 'sha256-xUHvBjJ4hahBW8qN9gceFBibSFUzbe9PNttUvehITzY=';
      s.onload = function () {
        qrState = 'idle';
        if (window.QRCode) renderQR();
        else {
          errorEl.textContent = 'QR code library loaded incorrectly. Try again.';
          console.error('QR library loaded without exposing its API.');
        }
      };
      s.onerror = function () {
        qrState = 'idle';
        errorEl.textContent = 'QR code could not load. Check your connection and try again.';
        console.error('QR library failed to load.');
      };
      document.head.appendChild(s);
    }
  }
  function hideQR() {
    document.getElementById('qr-overlay').style.display = 'none';
  }
  </script>

</main>

<!-- ── QR Overlay ── -->
<div id="qr-overlay"
     role="dialog"
     aria-modal="true"
     aria-label="QR Code"
     style="display:none;position:fixed;inset:0;z-index:100;background:rgba(0,0,0,0.75);
            backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
            align-items:center;justify-content:center;padding:16px;
            overflow:hidden;max-width:100vw">
  <div style="background:#0d1424;border:1px solid rgba(255,255,255,0.12);border-radius:20px;
              padding:28px 24px;max-width:calc(100vw - 32px);width:100%;text-align:center;
              box-shadow:0 24px 64px rgba(0,0,0,0.7)">
    <p class="font-bold text-sm mb-4" style="color:#e2e8f0">Scan to vote</p>
    <div id="qr-container" style="display:flex;justify-content:center;min-height:280px"></div>
    <p class="text-xs mt-3 break-all" style="color:#64748b" id="qr-url-label"></p>
    <p id="qr-error" class="text-sm mt-2" style="color:#fca5a5" role="alert"></p>
    <button type="button"
            onclick="hideQR()"
            class="btn-secondary mt-4"
            style="padding:8px 24px;font-size:0.8rem"
            aria-label="Close QR Code">
      Close
    </button>
  </div>
</div>

<script>
// Populate QR overlay URL label
(function () {
  var el = document.getElementById('qr-url-label');
  if (el) el.textContent = window.location.origin + window.location.pathname;
})();
</script>

</body>
</html>
