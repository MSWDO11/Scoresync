PORT=3000
SESSION_SECRET=replace-with-a-long-random-64-char-string

# Gmail SMTP — for automatic judge notification emails
# Get app password: https://myaccount.google.com/apppasswords (enable 2FA first)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Firebase — get these from Firebase Console > Project Settings > Your Apps
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
