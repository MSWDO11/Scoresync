{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "views/**",
          "public/**",
          "models/**",
          "controllers/**",
          "middleware/**",
          "routes/**",
          "utils/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/webfonts/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/index.js"
    },
    {
      "src": "/(tailwind\\.css|fa\\.min\\.css|fa\\.embedded\\.css)",
      "headers": {
        "Cache-Control": "public, max-age=604800, immutable"
      },
      "dest": "/index.js"
    },
    {
      "src": "/_health",
      "headers": {
        "Cache-Control": "no-store"
      },
      "dest": "/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
